# Owlat VPS Environment Configuration
# Generated by Owlat Control Plane
#
# Every `${VAR:?…}` in infra/templates/docker-compose.vps.yml must resolve, or
# compose aborts the WHOLE FILE at interpolation time — `down`, `logs`, `ps` and
# `config` included, not just `up`. So this file has to cover them all, and
# scripts/check-compose-invariants.sh fails the build when it stops doing so.
#
# The exceptions are injected into the deploy shell by the control plane rather
# than written here, because they name the release being rolled out and are not
# instance configuration. They are declared so the checker can tell "supplied
# elsewhere" apart from "forgotten":
#
# owlat:external OWLAT_VERSION — Owlat release tag the control plane is deploying
# owlat:external CONVEX_BACKEND_VERSION — pinned convex-backend image tag

# ── Convex ──
INSTANCE_SECRET={{INSTANCE_SECRET}}
CONVEX_ADMIN_KEY={{CONVEX_ADMIN_KEY}}
CONTROL_PLANE_URL={{CONTROL_PLANE_URL}}

# ── Code worker (only under --profile inbox-codetasks) ──
# The untrusted code-worker holds NO admin key: it reaches Convex through the
# convex-fn-proxy sidecar (which holds CONVEX_ADMIN_KEY and forwards only the
# thirteen allowlisted worker functions), authenticating with this token. Set it
# to enable code tasks; also copy infra/code-worker/tinyproxy.conf + .filter next
# to the compose file for the allowlisted egress proxy. Generate: openssl rand -base64 32
CODE_WORKER_PROXY_TOKEN=

# ── Redis ──
REDIS_PASSWORD={{REDIS_PASSWORD}}

# ── MTA ──
MTA_API_KEY={{MTA_API_KEY}}
MTA_WEBHOOK_SECRET={{MTA_WEBHOOK_SECRET}}
# Seals DKIM private keys + relay credentials at rest (>= 32 bytes; the MTA
# refuses to boot otherwise). Keep it STABLE across restarts — rotating it
# strands already-sealed values. Generate with: openssl rand -hex 32
MTA_SECRET={{MTA_SECRET}}
EHLO_HOSTNAME=mail.{{SLUG}}.owlat.app
RETURN_PATH_DOMAIN=bounces.{{SLUG}}.owlat.app
BOUNCE_VERP_KEY={{BOUNCE_VERP_KEY}}
IP_POOLS_TRANSACTIONAL=0.0.0.0
IP_POOLS_CAMPAIGN=0.0.0.0
MTA_IPV6_ENABLED=false
DKIM_KEYS={}
# Complaint deduplication has no safe automatic legacy upgrade, so the MTA makes
# the choice explicit and compose refuses to interpolate a blank value. Every
# instance provisioned from this template gets its own brand-new Redis, which is
# the definition of a fresh install — hence owned-v2 + fresh-install. An instance
# being migrated from a pre-owned-v2 deployment must instead follow the quiesced
# cutover in the MTA system docs and acknowledge with quiesced-v1-intake.
FBL_DEDUP_PROTOCOL=owned-v2
FBL_DEDUP_CUTOVER_ACK=fresh-install

# ── Auth: email verification ──
# Require a verified email before a signup or invitation acceptance can sign in
# (pushed into the Convex function runtime; drives BetterAuth's
# requireEmailVerification + sendOnSignUp + requireEmailVerificationOnInvitation).
# Defaulted ON for NEW VPS deployments — this template runs the built-in MTA, so
# the verification link can be delivered. Never enable it on an existing install
# with unverified legacy users without backfilling emailVerified first; an
# owner/admin can recover a stranded user via the mark-verified / resend actions.
REQUIRE_EMAIL_VERIFICATION=true

# ── Mail Sync (external IMAP/SMTP accounts — mail.external flag) ──
# Shared secret between Convex and the mail-sync worker. The Convex deployment
# also needs MAIL_SYNC_API_URL=http://mail-sync:3200 and MAIL_SYNC_API_KEY set
# as function env vars (alongside MTA_API_URL) so outbound external sends and
# the /test credential check reach the worker. Setup writes the URL into this
# file (and pushes both) once the flag is on — it is left out while the feature
# is off so a non-external install never pushes a URL pointing at a container
# that isn't running. Both are declared on the flag, so `owlat-setup doctor` and
# `owlat-setup env --show` name whichever is missing while the flag is on.
MAIL_SYNC_API_KEY={{MAIL_SYNC_API_KEY}}
# Messages per descending UID batch when importing a mailbox's history during a
# "Migrate from Google" migration. Lower it on tiny VPSes; raise it to import
# large mailboxes faster. Optional — defaults to 200.
# MAIL_SYNC_BACKFILL_BATCH=200

# ── Web ──
NUXT_PUBLIC_CONVEX_URL=http://localhost:3210
NUXT_PUBLIC_CONVEX_SITE_URL=http://localhost:3211
NUXT_PUBLIC_SITE_URL=https://app.owlat.app/{{SLUG}}

# ── Local LLM / Ollama (optional, "ai-worker" profile) ──
# The bundled `ollama` service runs under the same profile as the AI worker, so
# it activates when the `ai` feature flag is on. It is reachable only on the
# internal Docker network as ollama:11434 (no published host port). Pin the image
# tag here if you don't want :latest:
# OLLAMA_VERSION=latest
#
# To use it, set these Convex *function* env vars on the backend (convex env set):
#   LLM_PROVIDER=ollama
#   LLM_BASE_URL=http://ollama:11434/v1   # auto-resolved when LLM_PROVIDER=ollama
# No LLM_API_KEY is required for Ollama.

# ── Rate limiting (public endpoints) — STRONGLY RECOMMENDED ──
# Per-IP rate limiting on the public form / unsubscribe / preferences / DOI /
# tracking / webhook endpoints only works when the backend can trust a forwarded
# client-IP header. Set this Convex *function* env var (convex env set) so the
# limiter keys on the real client IP instead of a single shared bucket:
#   RATE_LIMIT_TRUSTED_PROXY=xforwarded
# This VPS fronts the backend with Caddy, which appends the client IP to
# X-Forwarded-For, so `xforwarded` (read from the right) is correct. Use
# `cloudflare` if Cloudflare terminates TLS instead — but note `cloudflare` /
# `xrealip` trust their header unconditionally, so also firewall the backend to
# the proxy's IP ranges (otherwise a direct request can forge it). `xforwarded`
# is bypass-resistant. Leaving it UNSET is fail-safe against spoofing but makes
# the limits coarse (one shared bucket), so a flood on a cheap public path can
# throttle others.

# ── PostHog analytics (analytics.posthog flag) ──
# Set both as Convex *function* env vars (convex env set) to pipe product events
# to a PostHog instance. Optional — the app works without them.
#   POSTHOG_API_KEY=phc_...
#   POSTHOG_HOST=https://eu.i.posthog.com

# ── URL reputation (scan.urls flag) ──
# Google Safe Browsing API key — checks outbound links before sending. Optional;
# set as a Convex *function* env var (convex env set).
#   GOOGLE_SAFE_BROWSING_API_KEY=

# ── Sender trust registry (ostr flag) ──
# The aggregator whose published sender standings this instance reads, and the
# ed25519 key its answers are verified against (an unverifiable answer is
# discarded, not believed). Optional; set both as Convex *function* env vars
# (convex env set). Unset ⇒ no lookups and inbound mail is filtered by exactly
# the signals it is filtered by today.
#   OSTR_AGGREGATOR_URL=
#   OSTR_AGGREGATOR_PUBLIC_KEY=
