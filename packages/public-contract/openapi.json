	"components": {
		"securitySchemes": {
			"apiKey": {
				"type": "http",
				"scheme": "bearer",
				"description": "An Owlat API key, sent as `Authorization: Bearer <key>`. Each operation lists the scope the key needs."
			}
		},
		"schemas": {
			"AddContactToTopicRequest": {
				"type": "object",
				"properties": {
					"email": {
						"type": ["string", "null"]
					},
					"contactId": {
						"type": ["string", "null"]
					}
				},
				"anyOf": [
					{
						"required": ["email"],
						"properties": {
							"email": {
								"type": "string",
								"minLength": 1
							}
						}
					},
					{
						"required": ["contactId"],
						"properties": {
							"contactId": {
								"type": "string",
								"minLength": 1
							}
						}
					}
				]
			},
			"AddToTopicResponse": {
				"type": "object",
				"properties": {
					"success": {
						"type": "boolean"
					},
					"contactId": {
						"type": "string"
					},
					"topicId": {
						"type": "string"
					},
					"doiStatus": {
						"type": "string",
						"enum": ["not_required", "pending", "confirmed"]
					}
				},
				"required": ["success", "contactId", "topicId", "doiStatus"],
				"additionalProperties": false
			},
			"ApiErrorResponse": {
				"type": "object",
				"properties": {
					"error": {
						"type": "object",
						"properties": {
							"category": {
								"type": "string",
								"description": "The error's classification, such as `invalid_input`, `not_found`, `conflict` or `rate_limited`. New categories can be added; treat an unknown one by its HTTP status."
							},
							"message": {
								"type": "string"
							},
							"data": {
								"type": "object",
								"propertyNames": {
									"type": "string"
								},
								"additionalProperties": {}
							}
						},
						"required": ["category", "message"],
						"additionalProperties": false
					}
				},
				"required": ["error"],
				"additionalProperties": false
			},
			"Contact": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"email": {
						"type": "string"
					},
					"firstName": {
						"type": ["string", "null"]
					},
					"lastName": {
						"type": ["string", "null"]
					},
					"source": {
						"type": "string",
						"enum": ["api", "import", "form", "transactional", "inbound"]
					},
					"createdAt": {
						"type": "string",
						"description": "ISO 8601 timestamp."
					},
					"updatedAt": {
						"type": "string",
						"description": "ISO 8601 timestamp."
					}
				},
				"required": ["id", "email", "firstName", "lastName", "source", "createdAt", "updatedAt"],
				"additionalProperties": false
			},
			"CreateContactRequest": {
				"type": "object",
				"properties": {
					"email": {
						"type": "string",
						"minLength": 1
					},
					"firstName": {
						"type": "string"
					},
					"lastName": {
						"type": "string"
					}
				},
				"required": ["email"]
			},
			"DeleteContactResponse": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"deleted": {
						"type": "boolean"
					}
				},
				"required": ["id", "deleted"],
				"additionalProperties": false
			},
			"HealthStatus": {
				"type": "object",
				"properties": {
					"status": {
						"type": "string",
						"const": "ok"
					},
					"timestamp": {
						"type": "string"
					}
				},
				"required": ["status", "timestamp"],
				"additionalProperties": false
			},
			"PaginationMeta": {
				"type": "object",
				"properties": {
					"limit": {
						"type": "integer"
					},
					"totalItems": {
						"type": "integer"
					},
					"cursor": {
						"type": ["string", "null"]
					},
					"isDone": {
						"type": "boolean"
					}
				},
				"required": ["limit", "totalItems", "cursor", "isDone"],
				"additionalProperties": false
			},
			"RemoveFromTopicResponse": {
				"type": "object",
				"properties": {
					"success": {
						"type": "boolean"
					},
					"removed": {
						"type": "boolean"
					}
				},
				"required": ["success", "removed"],
				"additionalProperties": false
			},
			"SendEventRequest": {
				"type": "object",
				"properties": {
					"email": {
						"type": "string",
						"minLength": 1
					},
					"eventName": {
						"type": "string",
						"minLength": 1,
						"pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,99}$"
					},
					"eventProperties": {
						"type": "object",
						"propertyNames": {
							"type": "string"
						},
						"additionalProperties": {
							"type": ["string", "number", "boolean", "null"]
						}
					},
					"createContactIfNotExists": {
						"type": "boolean"
					}
				},
				"required": ["email", "eventName"]
			},
			"SendEventResponse": {
				"type": "object",
				"properties": {
					"eventId": {
						"type": "string"
					},
					"contactId": {
						"type": "string"
					},
					"eventName": {
						"type": "string"
					},
					"triggeredAutomations": {
						"type": "integer"
					},
					"contactCreated": {
						"type": "boolean"
					}
				},
				"required": ["eventId", "contactId", "eventName", "triggeredAutomations", "contactCreated"],
				"additionalProperties": false
			},
			"SendTransactionalRequest": {
				"type": "object",
				"properties": {
					"email": {
						"type": "string",
						"minLength": 1
					},
					"transactionalId": {
						"type": ["string", "null"]
					},
					"slug": {
						"type": ["string", "null"]
					},
					"dataVariables": {
						"type": "object",
						"propertyNames": {
							"type": "string"
						},
						"additionalProperties": {
							"type": ["string", "number", "boolean", "null"]
						}
					},
					"language": {
						"type": "string",
						"pattern": "^(?:[A-Za-z]{2}(?:-[A-Za-z]{2,3})?)?$"
					},
					"attachments": {
						"maxItems": 10,
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/TransactionalAttachment"
						}
					}
				},
				"required": ["email"],
				"anyOf": [
					{
						"required": ["transactionalId"],
						"properties": {
							"transactionalId": {
								"type": "string",
								"minLength": 1
							}
						}
					},
					{
						"required": ["slug"],
						"properties": {
							"slug": {
								"type": "string",
								"minLength": 1
							}
						}
					}
				]
			},
			"SendTransactionalResponse": {
				"type": "object",
				"properties": {
					"status": {
						"type": "string",
						"const": "queued"
					},
					"email": {
						"type": "string"
					},
					"transactionalEmailId": {
						"type": "string",
						"description": "ID of the send record created for this email, not the template ID. Delivery webhooks carry it."
					},
					"slug": {
						"type": "string"
					},
					"contactId": {
						"type": "string"
					},
					"contactCreated": {
						"type": "boolean"
					},
					"language": {
						"type": "string"
					}
				},
				"required": [
					"status",
					"email",
					"transactionalEmailId",
					"slug",
					"contactCreated",
					"language"
				],
				"additionalProperties": false
			},
			"TransactionalAttachment": {
				"type": "object",
				"properties": {
					"filename": {
						"type": "string",
						"minLength": 1,
						"pattern": "^[^/\\\\]*$"
					},
					"content": {
						"type": "string"
					},
					"url": {
						"type": "string"
					},
					"contentType": {
						"type": "string"
					}
				},
				"required": ["filename"],
				"oneOf": [
					{
						"required": ["content"]
					},
					{
						"required": ["url"]
					}
				]
			},
			"UpdateContactRequest": {
				"type": "object",
				"properties": {
					"email": {
						"type": "string"
					},
					"firstName": {
						"type": "string"
					},
					"lastName": {
						"type": "string"
					}
				}
			}
		}
	}
}
