		"/api/v1/events": {
			"post": {
				"operationId": "sendEvent",
				"tags": ["Events"],
				"summary": "Record an event for a contact and fire the automations it triggers.",
				"security": [
					{
						"apiKey": ["events:write"]
					}
				],
				"parameters": [
					{
						"name": "Idempotency-Key",
						"in": "header",
						"required": false,
						"description": "Makes the request safe to retry: the server applies it at most once per key for 24 hours and answers a repeat with the first response. 1 to 255 printable ASCII characters without spaces.",
						"schema": {
							"type": "string",
							"minLength": 1,
							"maxLength": 255,
							"pattern": "^[!-~]+$"
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/SendEventRequest"
							},
							"example": {
								"email": "ada@example.com",
								"eventName": "signup_completed",
								"eventProperties": {
									"plan": "pro",
									"seats": 3,
									"trial": false,
