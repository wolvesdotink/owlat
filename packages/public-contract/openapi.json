	"paths": {
		"/api/v1/health": {
			"get": {
				"operationId": "getHealth",
				"tags": ["Health"],
				"summary": "Check that the API answers. Needs no API key.",
				"security": [],
				"responses": {
					"200": {
						"description": "The API is up.",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"data": {
											"$ref": "#/components/schemas/HealthStatus"
										}
									},
									"required": ["data"],
									"additionalProperties": false
								},
								"example": {
									"data": {
										"status": "ok",
										"timestamp": "2026-01-15T09:30:00.000Z"
									}
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/contacts": {
			"get": {
				"operationId": "listContacts",
				"tags": ["Contacts"],
				"summary": "List contacts, a page at a time.",
				"security": [
					{
						"apiKey": ["contacts:read"]
					}
				],
				"parameters": [
					{
						"name": "limit",
						"in": "query",
						"required": false,
						"description": "Items per page, at most 100; a larger value is clamped.",
						"schema": {
							"type": "integer",
							"minimum": 1,
							"maximum": 100,
							"default": 25
						}
					},
					{
						"name": "cursor",
						"in": "query",
						"required": false,
						"description": "The previous page's `pagination.cursor`. Omit it for the first page.",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "search",
						"in": "query",
						"required": false,
						"description": "Filter by a search query; results are relevance-ordered.",
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "One page of contacts.",
						"headers": {
							"X-RateLimit-Limit": {
								"description": "Requests allowed per window for this key.",
								"schema": {
									"type": "integer"
								}
							},
							"X-RateLimit-Remaining": {
								"description": "Requests left in the current window.",
								"schema": {
									"type": "integer"
								}
							},
							"X-RateLimit-Reset": {
								"description": "When the window resets, as a Unix timestamp.",
								"schema": {
									"type": "integer"
								}
							}
						},
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"data": {
											"type": "array",
											"items": {
												"$ref": "#/components/schemas/Contact"
											}
										},
										"pagination": {
											"$ref": "#/components/schemas/PaginationMeta"
										}
									},
									"required": ["data", "pagination"],
									"additionalProperties": false
								},
								"example": {
									"data": [
										{
											"id": "k57c0ntact00000000000000000000",
											"email": "ada@example.com",
											"firstName": "Ada",
											"lastName": null,
											"source": "api",
											"createdAt": "2026-01-15T09:30:00.000Z",
											"updatedAt": "2026-01-16T10:00:00.000Z"
										},
										{
											"id": "k57c0ntact00000000000000000001",
											"email": "ada@example.com",
											"firstName": "Ada",
											"lastName": null,
											"source": "inbound",
											"createdAt": "2026-01-15T09:30:00.000Z",
											"updatedAt": "2026-01-16T10:00:00.000Z"
										}
									],
									"pagination": {
										"limit": 25,
										"totalItems": 42,
