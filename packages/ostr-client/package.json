{
	"name": "@owlat/ostr-client",
	"version": "0.4.4",
	"private": true,
	"description": "OSTR consumer library: DNS tier lookup (TXT + RBL-compatible A-record views), signed snapshot + diff-feed sync, local cache, and per-consumer observer re-weighting. Prefers local snapshot data over DNS so a receiver's traffic pattern is not leaked via lookups.",
	"homepage": "https://owlat.app",
	"license": "Apache-2.0",
	"type": "module",
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"scripts": {
		"lint": "oxlint --config ../../oxlintrc.json src",
		"lint:fix": "oxlint --config ../../oxlintrc.json src --fix",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage --passWithNoTests"
	},
	"dependencies": {
		"@owlat/ostr-core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
