{
	"name": "@owlat/mta-protocol",
	"version": "0.4.1",
	"private": true,
	"description": "The Convex<->MTA wire contract (D7): send intake, routing decisions, the IP-reputation snapshot and the MTA webhook events, each declared exactly once and imported by both apps. Types and pure validators only — no I/O, no third-party dependencies.",
	"homepage": "https://owlat.app",
	"license": "Apache-2.0",
	"type": "module",
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./send": {
			"types": "./src/send.ts",
			"import": "./src/send.ts"
		},
		"./routingDecision": {
			"types": "./src/routingDecision.ts",
			"import": "./src/routingDecision.ts"
		},
		"./webhookEvent": {
			"types": "./src/webhookEvent.ts",
			"import": "./src/webhookEvent.ts"
		},
		"./ipReputation": {
			"types": "./src/ipReputation.ts",
			"import": "./src/ipReputation.ts"
		},
		"./wireFixtures": {
			"types": "./src/wireFixtures.ts",
			"import": "./src/wireFixtures.ts"
		}
	},
	"scripts": {
		"lint": "oxlint --config ../../oxlintrc.json src",
		"lint:fix": "oxlint --config ../../oxlintrc.json src --fix",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@owlat/shared": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
