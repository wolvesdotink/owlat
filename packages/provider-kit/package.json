{
	"name": "@owlat/provider-kit",
	"version": "0.6.27",
	"description": "Runtime-neutral contracts for Owlat send-provider bundles",
	"keywords": [
		"email",
		"owlat",
		"plugins",
		"send-provider"
	],
	"homepage": "https://owlat.app",
	"bugs": {
		"url": "https://github.com/wolvesdotink/owlat/issues"
	},
	"license": "Apache-2.0",
	"author": "wolves <npm@wolves.ink>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wolvesdotink/owlat.git",
		"directory": "packages/provider-kit"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup src/index.ts --format esm --dts --sourcemap --target node20 --clean",
		"prepack": "bun run build && bun ../plugin-kit/scripts/packageLegalFiles.ts stage",
		"postpack": "bun ../plugin-kit/scripts/packageLegalFiles.ts clean",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"test:coverage": "vitest run --coverage",
		"lint": "oxlint --config ../../oxlintrc.json src",
		"lint:fix": "oxlint --config ../../oxlintrc.json src --fix",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"tsup": "^9.0.0",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
