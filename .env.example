# ============================================================
# Owlat — LOCAL DEVELOPMENT env (for working on Owlat itself)
# ============================================================
# Audience: contributors running `bun run dev` / `bun run setup` against a
# local Convex backend (or a hosted convex.cloud deployment). For a
# self-hosted Docker Compose deployment, copy .env.selfhost.example instead —
# the two templates are NOT interchangeable.

# Nuxt Public Configuration
# The Convex deployment URL (local backend binds 3210; e.g. a hosted
# deployment would be https://your-deployment.convex.cloud)
NUXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# The Convex HTTP site URL for auth callbacks and API routes (local: 3211)
NUXT_PUBLIC_CONVEX_SITE_URL=http://localhost:3211

# The public site URL for your application
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# PostHog product analytics (optional — app works without it)
NUXT_PUBLIC_POSTHOG_API_KEY=
NUXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ============================================================
# Convex Environment Variables
# ============================================================
# These variables are set in the Convex deployment settings, not in this file.
# They are documented here for reference.
# See: apps/docs/developer/environment-variables.md

# --- Auth ---
# BETTER_AUTH_SECRET=your-secret-key-here
# SITE_URL=http://localhost:3000

# --- Dev shortcuts ---
# Set to enable `/seed/demo`, `/dev/reset`, and Force Verify Domain. Leave
# unset on any production deployment.
#   npx convex env set OWLAT_DEV_MODE true
# OWLAT_DEV_MODE=true

# --- Email Provider ---
# EMAIL_PROVIDER=mta                     # "mta", "ses", "resend", "smtp", or
#                                        # "mandrill". No default: leave it unset
#                                        # and sends are refused (fail-closed),
#                                        # not routed to the built-in MTA
# OUTBOUND_TLS_MODE=opportunistic        # built-in MTA direct-MX TLS floor:
#                                        # "opportunistic" (default), "require", or
#                                        # "require-verified" (can bounce mail to
#                                        # receivers with broken/self-signed TLS)
# DANE_MODE=report                       # RFC 7672 DANE at send time: "off",
#                                        # "report" (default — evaluate + report in
#                                        # TLS-RPT, never bounce), or "enforce".
#                                        # Inert unless DANE_RESOLVER_URL is set, so
#                                        # a fresh install behaves exactly as before.
# DANE_RESOLVER_URL=https://127.0.0.1:8443/dns-query  # VALIDATING DoH resolver (AD
#                                        # bit trusted); https:// (http only loopback)
# SMTP_POOL_MAX_MESSAGES_PER_CONNECTION=100  # deliveries over one reused MX socket
#                                        # before a clean QUIT + reconnect (true
#                                        # RSET socket reuse; ~100 default)

# AWS SES (required if EMAIL_PROVIDER=ses)
# AWS_SES_REGION=eu-west-1
# AWS_SES_ACCESS_KEY_ID=AKIA...
# AWS_SES_SECRET_ACCESS_KEY=...
# Optional: SES Configuration Set applied to every send so bounce/complaint/
# delivery feedback (SNS → /webhooks/ses) is attributed to the originating send.
# SES_CONFIGURATION_SET=owlat-ses
# Required to enable the /webhooks/ses feedback loop: the exact SNS topic ARN
# authorized to deliver feedback. A valid SNS signature only proves AWS
# authorship, so Owlat rejects any envelope from a different topic and keeps the
# endpoint closed (503) until this is set.
# SES_SNS_TOPIC_ARN=arn:aws:sns:eu-west-1:123456789012:owlat-ses-feedback

# Resend (required if EMAIL_PROVIDER=resend)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_WEBHOOK_SECRET=whsec_...

# Mailchimp Transactional / Mandrill (required if EMAIL_PROVIDER=mandrill).
# The migration arm: a team arriving from Mailchimp keeps sending through their
# existing Mandrill account on day one, and the ramp controller moves traffic
# onto Owlat's own MTA cell by cell. Owlat composes the whole MIME message
# itself and posts it to messages/send-raw with Mandrill's open/click tracking,
# link rewriting and auto-text OFF — tracking is first-party, so both arms are
# measured on identical instrumentation.
# MANDRILL_API_KEY=md-xxxxxxxxxxxxxxxxxxxxxx
# Per-webhook signing key, shown by Mandrill once you create a webhook pointing
# at <CONVEX_SITE_URL>/webhooks/mandrill. Enable send, deferral, hard_bounce,
# soft_bounce, spam, unsub and reject — NOT open/click. Without it there is no
# verified feedback loop and this arm's bounces never reach Owlat.
# MANDRILL_WEBHOOK_KEY=...
# Optional: isolate Owlat's traffic (and its reputation) inside a shared
# Mandrill account.
# MANDRILL_SUBACCOUNT=owlat
# Optional: default dedicated-IP pool name. A provider route's own ipPool
# overrides it per send.
# MANDRILL_IP_POOL=Main Pool

# Generic SMTP relay (required if EMAIL_PROVIDER=smtp) — works with Mailgun,
# Postmark, SendGrid, Brevo or any custom SMTP submission host. The relay owns
# the sending IPs and DKIM signing, so set up SPF/DKIM for your From-domain in
# the relay's dashboard (not through the built-in MTA DNS bundle).
# SMTP_RELAY_HOST=smtp.mailgun.org
# SMTP_RELAY_PORT=587                    # 587 = STARTTLS (default); 465 = implicit TLS
# SMTP_RELAY_SECURE=false                # "true" only for implicit TLS on 465
# SMTP_RELAY_USERNAME=postmaster@mg.example.com
# A plaintext value works; Owlat setup (CLI wizard, `owlat-setup env`) and the
# in-app transport editor store this SEALED at rest (an `envsealed:v1:…` token
# encrypted under INSTANCE_SECRET) and the deploy step unseals it automatically
# — don't edit a sealed token by hand, just replace it with the new plaintext
# password.
# SMTP_RELAY_PASSWORD=...
# Relay bounce feedback (optional, additive). Set BOTH to let relay sends carry
# our own VERP envelope sender, so bounces the relay generates come back to the
# built-in MTA's bounce server and the relay arm produces bounce data comparable
# with the direct-MX arm. Setup PROJECTS both from the MTA's
# canonical variables (BOUNCE_VERP_KEY -> MTA_BOUNCE_VERP_KEY,
# RETURN_PATH_DOMAIN -> MTA_RETURN_PATH_DOMAIN), so a normal install needs
# neither line here; set them only when the MTA lives elsewhere. They MUST match
# the MTA's values exactly — a mismatched signing key mints tokens the MTA will
# never verify, which reads downstream as "this arm produced no bounces". A key
# shorter than 32 bytes (the MTA's own floor) is ignored rather than used.
# Leave both unset and nothing breaks: relay sends keep the
# composer's envelope sender and that arm is simply graded degraded-measurement.
# Whether a given relay honours a custom return path is detected by probe, never
# assumed. The probe sends from DEFAULT_FROM_EMAIL (an identity the relay is
# already verified for — the return-path domain's SPF authorises the MTA pool,
# not the relay, and most ESPs refuse an unverified From); with that unset the
# probe simply does not run and the transport stays degraded-measurement.
# MTA_BOUNCE_VERP_KEY=
# MTA_RETURN_PATH_DOMAIN=bounces.example.com
# SPF mechanism terms that authorise your RELAY to send with a
# bounce+...@<return-path host> envelope sender (space- or comma-separated;
# include:/a:/mx:/ip4:/ip6: only, anything else is ignored). The generated
# return-path SPF record authorises the MTA pool IPs, so without these the
# relay would fail SPF on the bounce domain and the stamp stays OFF: the relay
# arm keeps the composer's envelope sender and is graded degraded-measurement.
# Set this to your relay's published SPF include, re-verify the domain so the
# record is republished, and the stamp turns itself on. Unset changes nothing
# and blocks nothing. At most 5 terms are accepted (RFC 7208 caps an SPF
# evaluation at ten DNS lookups and the record spends some on the pool); the
# excess is dropped. These terms ADD to the pool authorisation, they do not
# replace it: with MTA_IP_POOLS unset there is no return-path SPF record to add
# them to, so set the pool first.
# MTA_RETURN_PATH_RELAY_SPF=include:relay.example.net

# BIMI (optional, and optional in every sense). Once a sending domain's DMARC is
# at p=quarantine or stricter the domain wizard OFFERS a BIMI record; with these
# unset it explains what BIMI and a VMC are and generates nothing. Setting them
# never blocks a send, a warm-up or a verification — a missing logo is a missing
# logo. MTA_BIMI_LOGO_URL is the HTTPS URL of your SVG Tiny PS logo (the `l=`
# tag) and MTA_BIMI_VMC_URL the HTTPS URL of your Verified Mark Certificate PEM
# (the `a=` tag) — Gmail and Apple Mail display the logo only with a VMC, other
# receivers show it from the record alone. Both must be plain HTTPS URLs; a
# value that is not one is ignored and the wizard says which one to fix rather
# than publishing a record that does not parse. MTA_BIMI_SELECTOR names the
# record host (<selector>._bimi.<domain>); unset means the spec's `default`.
# MTA_BIMI_LOGO_URL=https://example.com/brand/logo.svg
# MTA_BIMI_VMC_URL=https://example.com/brand/vmc.pem
# MTA_BIMI_SELECTOR=default

# Additional NAMED transport instances (optional). Every transport kind above
# already has one default instance that reads the unsuffixed variables; declare
# extra instances here as a comma-separated list of `<kind>#<instanceKey>` when
# you want two configurations of the SAME kind side by side — e.g. keeping a
# warm fallback relay while trialling a second one. Each named instance reads
# its kind's variables suffixed with `__<INSTANCEKEY>`, so `smtp#backup` reads
# SMTP_RELAY_HOST__BACKUP / SMTP_RELAY_USERNAME__BACKUP / SMTP_RELAY_PASSWORD__BACKUP.
# Instance keys are lowercase [a-z0-9][a-z0-9_-]{0,31}. Removing an instance
# from this list (or removing its variables) makes sends addressed to that
# transport id fail closed — they never silently borrow another transport.
# Only the built-in kinds can have named instances: a plugin-contributed kind
# reads its configuration from the plugin's own deployment-wide variables, so
# declaring one here has no effect and dispatching to it fails closed. A second
# declaration whose key derives the same variable suffix as an earlier one
# (`a-b` and `a_b` both give `__A_B`) is ignored for the same reason.
# SEND_TRANSPORT_INSTANCES=smtp#backup
# SMTP_RELAY_HOST__BACKUP=smtp.postmarkapp.com
# SMTP_RELAY_USERNAME__BACKUP=...
# SMTP_RELAY_PASSWORD__BACKUP=...

# Common email configuration
# DEFAULT_FROM_EMAIL=noreply@example.com
# DEFAULT_FROM_NAME=Owlat
# DEFAULT_FROM_DOMAIN=mail.owlat.app
# CONVEX_SITE_URL=https://your-deployment.convex.site
# UNSUBSCRIBE_SECRET=your-unsubscribe-secret

# --- Microsoft SNDS (optional external reputation signal) ---
# Comma- or whitespace-separated "Automated Data Access" feed URLs from the
# Microsoft SNDS portal, one per registered IP range (https only). Owlat polls
# them every six hours and stores the per-IP, per-day complaint BAND, filter
# result and spam-trap hits — Microsoft publishes bands, not rates, and Owlat
# keeps them as bands rather than inventing a percentage.
# Each URL is a bearer capability to your SNDS data: keep it secret.
# Leave this unset if you have not enrolled. That is a supported configuration:
# the Microsoft ramp then relies on SMTP reply classification, dwells twice as
# long before advancing and caps one phase lower. Nothing errors or nags.
# SNDS_DATA_FEED_URLS=https://sendersupport.olc.protection.outlook.com/snds/ada/...

# --- OSTR (trust registry) ---
# The Open Sender Trust Registry: signed evidence about how a domain or IP has
# behaved as a sender, kept in an append-only transparency log and scored by an
# open function anyone can re-run. Everything below is opt-in and everything
# below is unset by default — an Owlat that ignores this section queries no
# registry and publishes nothing about the mail it receives.
# Full guide: docs/developer/trust-registry. Spec: docs/ostr/.

# Not every variable below belongs in this file. The registry-node and MTA keys
# are read from here by the compose services; the observer identity and log keys
# are Convex *function* variables and are shown as `convex env set` lines,
# because a Convex function cannot read this file and putting them here does
# nothing. Two are both, with the same value on each side: the aggregator pair,
# and OSTR_OBSERVER_ENABLED (see below).

# Consuming: which aggregator to trust. The public key is what makes a snapshot
# or a diff verifiable, so a URL without one is just an unauthenticated feed —
# set both or neither. The MTA verifies snapshots on the inbound path itself and
# reads them from THIS file; the Convex functions need their own copies. The URL
# is an origin — request paths are absolute (`/v1/snapshot`), so any path you
# append to it is ignored:
#   convex env set OSTR_AGGREGATOR_URL https://ostr.example
#   convex env set OSTR_AGGREGATOR_PUBLIC_KEY <base64 ed25519 public key>
# OSTR_AGGREGATOR_URL=https://ostr.example
# OSTR_AGGREGATOR_PUBLIC_KEY=raw-32-byte-ed25519-public-key-base64

# Consuming, MTA side: the tier lookup on inbound mail. OSTR_ENABLED turns the
# signal on (default false); OSTR_ZONE is the aggregator's DNS zone apex, the
# `q.` label is added by the query itself. The lookup is advisory and bounded —
# on timeout the message is treated as it would be with no registry at all.
# The `ostr` feature flag decides what a resolved tier is allowed to DO: with it
# on, a `flagged` sender's mail is filed as spam; with it off, the tier is still
# recorded on the message, so you can see what the flag would have done first.
# Nothing below `flagged` moves a message either way. The flag requires the
# `postbox` plane and cannot resolve true without it, and it also decides
# whether the per-message tier chip renders in the reader.
# OSTR_ENABLED=false
# OSTR_ZONE=ostr.example
# OSTR_LOOKUP_TIMEOUT_MS=2000

# Publishing (observer mode): your instance signs attestations about mail it
# actually received and submits them to the logs. Off by default, and env-gated
# rather than feature-flagged because turning it on is a privacy decision, not a
# product one — read the small-instance warning in the developer guide first.
# Below the packaged mailbox floor the observer refuses to publish: a
# single-mailbox observer attesting "one report about X" tells X who reported.
# The packaged floor is 5 mailboxes; OSTR_MIN_MAILBOXES may only RAISE it, and
# a lower value is ignored. OSTR_LOG_URLS is comma-separated and each entry is a
# FULL submission endpoint, path included — it is POSTed to verbatim, so a bare
# origin or a base path 404s every submission. Attestations cross-submit to at
# least two logs so one operator cannot quietly drop yours.
# All five are Convex function variables — set them after deploying functions:
#   convex env set OSTR_OBSERVER_ENABLED true
#   convex env set OSTR_OBSERVER_DOMAIN mx.example.com
#   convex env set OSTR_OBSERVER_PRIVATE_KEY <base64 ed25519 private key>
#   convex env set OSTR_LOG_URLS https://log-a.example/v1/attestations,https://log-b.example/v1/attestations
#   convex env set OSTR_MIN_MAILBOXES 25
# OSTR_OBSERVER_ENABLED is the one that belongs in BOTH places. Observer mode
# has two halves: the MTA captures the DKIM evidence a published attestation
# rests on, and Convex retains, signs and submits it. The MTA half reads this
# file, the Convex half reads `convex env set`, and setting one without the
# other publishes nothing — evidence captured but never signed, or an observer
# with nothing to attest about.
# OSTR_OBSERVER_ENABLED=false

# Running a registry node of your own (docker compose --profile ostr up -d).
# Only needed to OPERATE a registry — a private federation, a staging log, or a
# second public node. Consuming and observing both talk to somebody else's.
# Put `ostr` in COMPOSE_PROFILES rather than relying on `--profile` alone: the
# in-app updater runs `docker compose pull` + `up -d` against COMPOSE_PROFILES,
# so a `--profile`-only node is skipped by every upgrade and keeps running its
# original image, silently, while the compose file is replaced under it. The
# entry does not survive a feature-flag toggle in the admin UI (that line is
# rewritten from the flag registry and no flag claims `ostr`), so re-check it
# after one — or update the node by hand with `--profile ostr pull && up -d`.
# The two signing keys are required and must differ: one commits to "this log
# contains these leaves", the other to "this aggregator computed these scores",
# and one key for both makes the claims indistinguishable to a monitor.
# apps/ostr-registry/README.md has the one-liner that generates them.
# OSTR_LOG_ID=ostr-log-example-1
# OSTR_LOG_PRIVATE_KEY=raw-32-byte-ed25519-private-key-base64
# OSTR_AGGREGATOR_PRIVATE_KEY=raw-32-byte-ed25519-private-key-base64
# Zone apex the node publishes under, and the evidence-page base URL stamped
# into every TXT answer. Unset, the zone apex is RFC 2606's reserved
# `ostr.invalid` and the reference URL derives from it (https://<apex>/s).
# OSTR_ZONE_ORIGIN=ostr.example
# OSTR_REF_BASE_URL=https://ostr.example/s
# Cadences, in seconds: how often a signed tree head is published, how often
# scores/zone/snapshot recompute, and the maximum merge delay every inclusion
# promise states. Heads must not be published less often than the promised
# delay, or every promise is one the node cannot keep — the node refuses to
# start on that combination.
# OSTR_STH_INTERVAL_SECONDS=3600
# OSTR_REFRESH_INTERVAL_SECONDS=3600
# OSTR_MMD_SECONDS=86400
# Node-wide ceiling on accepted submissions per minute. Unset means no limit;
# a limit, once set, is part of the node's published policy.
# OSTR_SUBMIT_RATE_PER_MINUTE=600
# The published submission allowlist. UNSET means open submission — any
# observer publishing a key at `_ostr.<domain>`. Set means only these, keys
# still from DNS unless an entry pins one as `domain=<base64 public key>`.
# Leaving it present but EMPTY is refused rather than read as "open".
# OSTR_BOOTSTRAP_OBSERVERS=mx.a.example,mx.b.example
# Storage and listener. The compose service pins all three (a container path,
# 3300, 0.0.0.0); they matter when running the node outside this stack.
# OSTR_DB_DIR=./.data
# OSTR_REGISTRY_PORT=3300
# OSTR_REGISTRY_LISTEN=0.0.0.0
# The node's own log verbosity, passed to the container as LOG_LEVEL. One of
# trace, debug, info, warn, error, fatal, silent.
# OSTR_REGISTRY_LOG_LEVEL=info

# --- Analytics (PostHog) ---
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://eu.i.posthog.com

# --- Translations (AI) ---
# OPENROUTER_API_KEY=sk-or-...           # Primary provider
# OPENAI_API_KEY=sk-...                  # Fallback provider

# --- CORS ---
# Allowed origins for CORS on private API endpoints (comma-separated)
# ALLOWED_ORIGINS=https://app.owlat.app,http://localhost:3000

# --- CI only: ramp gate standalone matrix ---
# Selects which leg of the deliverability ramp gate suite runs (see the
# `ramp-gate-matrix` job in .github/workflows/test.yml). NOT read by any
# deployable — it configures a test run, never the product.
# OWLAT_RAMP_GATE_MATRIX_MODE=reference_arm   # or: standalone
