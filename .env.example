# ============================================================
# Owlat — LOCAL DEVELOPMENT env (for working on Owlat itself)
# ============================================================
# Audience: contributors running `bun run dev` / `bun run setup` against a
# local Convex backend (or a hosted convex.cloud deployment). For a
# self-hosted Docker Compose deployment, copy .env.selfhost.example instead —
# the two templates are NOT interchangeable.

# Nuxt Public Configuration
# The Convex deployment URL (local backend binds 3210; e.g. a hosted
# deployment would be https://your-deployment.convex.cloud)
NUXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# The Convex HTTP site URL for auth callbacks and API routes (local: 3211)
NUXT_PUBLIC_CONVEX_SITE_URL=http://localhost:3211

# The public site URL for your application
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# PostHog product analytics (optional — app works without it)
NUXT_PUBLIC_POSTHOG_API_KEY=
NUXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ============================================================
# Convex Environment Variables
# ============================================================
# These variables are set in the Convex deployment settings, not in this file.
# They are documented here for reference.
# See: apps/docs/developer/environment-variables.md

# --- Auth ---
# BETTER_AUTH_SECRET=your-secret-key-here
# SITE_URL=http://localhost:3000

# --- Dev shortcuts ---
# Set to enable `/seed/demo`, `/dev/reset`, and Force Verify Domain. Leave
# unset on any production deployment.
#   npx convex env set OWLAT_DEV_MODE true
# OWLAT_DEV_MODE=true

# --- Email Provider ---
# EMAIL_PROVIDER=mta                     # "mta" (default), "ses", "resend", or "smtp"
# OUTBOUND_TLS_MODE=opportunistic        # built-in MTA direct-MX TLS floor:
#                                        # "opportunistic" (default), "require", or
#                                        # "require-verified" (can bounce mail to
#                                        # receivers with broken/self-signed TLS)
# DANE_MODE=report                       # RFC 7672 DANE at send time: "off",
#                                        # "report" (default — evaluate + report in
#                                        # TLS-RPT, never bounce), or "enforce".
#                                        # Inert unless DANE_RESOLVER_URL is set, so
#                                        # a fresh install behaves exactly as before.
# DANE_RESOLVER_URL=https://127.0.0.1:8443/dns-query  # VALIDATING DoH resolver (AD
#                                        # bit trusted); https:// (http only loopback)
# SMTP_POOL_MAX_MESSAGES_PER_CONNECTION=100  # deliveries over one reused MX socket
#                                        # before a clean QUIT + reconnect (true
#                                        # RSET socket reuse; ~100 default)

# AWS SES (required if EMAIL_PROVIDER=ses)
# AWS_SES_REGION=eu-west-1
# AWS_SES_ACCESS_KEY_ID=AKIA...
# AWS_SES_SECRET_ACCESS_KEY=...
# Optional: SES Configuration Set applied to every send so bounce/complaint/
# delivery feedback (SNS → /webhooks/ses) is attributed to the originating send.
# SES_CONFIGURATION_SET=owlat-ses
# Required to enable the /webhooks/ses feedback loop: the exact SNS topic ARN
# authorized to deliver feedback. A valid SNS signature only proves AWS
# authorship, so Owlat rejects any envelope from a different topic and keeps the
# endpoint closed (503) until this is set.
# SES_SNS_TOPIC_ARN=arn:aws:sns:eu-west-1:123456789012:owlat-ses-feedback

# Resend (required if EMAIL_PROVIDER=resend)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_WEBHOOK_SECRET=whsec_...

# Generic SMTP relay (required if EMAIL_PROVIDER=smtp) — works with Mailgun,
# Postmark, SendGrid, Brevo or any custom SMTP submission host. The relay owns
# the sending IPs and DKIM signing, so set up SPF/DKIM for your From-domain in
# the relay's dashboard (not through the built-in MTA DNS bundle).
# SMTP_RELAY_HOST=smtp.mailgun.org
# SMTP_RELAY_PORT=587                    # 587 = STARTTLS (default); 465 = implicit TLS
# SMTP_RELAY_SECURE=false                # "true" only for implicit TLS on 465
# SMTP_RELAY_USERNAME=postmaster@mg.example.com
# A plaintext value works; Owlat setup (CLI wizard, `owlat-setup env`) and the
# in-app transport editor store this SEALED at rest (an `envsealed:v1:…` token
# encrypted under INSTANCE_SECRET) and the deploy step unseals it automatically
# — don't edit a sealed token by hand, just replace it with the new plaintext
# password.
# SMTP_RELAY_PASSWORD=...
# Relay bounce feedback (optional, additive). Set BOTH to let relay sends carry
# our own VERP envelope sender, so bounces the relay generates come back to the
# built-in MTA's bounce server and the relay arm produces bounce data comparable
# with the direct-MX arm. MTA_BOUNCE_VERP_KEY must be the SAME value as the
# MTA's BOUNCE_VERP_KEY, and MTA_RETURN_PATH_DOMAIN the same as its
# RETURN_PATH_DOMAIN. Leave both unset and nothing breaks: relay sends keep the
# composer's envelope sender and that arm is simply graded degraded-measurement.
# Whether a given relay honours a custom return path is detected by probe, never
# assumed.
# MTA_BOUNCE_VERP_KEY=
# MTA_RETURN_PATH_DOMAIN=bounces.example.com

# Additional NAMED transport instances (optional). Every transport kind above
# already has one default instance that reads the unsuffixed variables; declare
# extra instances here as a comma-separated list of `<kind>#<instanceKey>` when
# you want two configurations of the SAME kind side by side — e.g. keeping a
# warm fallback relay while trialling a second one. Each named instance reads
# its kind's variables suffixed with `__<INSTANCEKEY>`, so `smtp#backup` reads
# SMTP_RELAY_HOST__BACKUP / SMTP_RELAY_USERNAME__BACKUP / SMTP_RELAY_PASSWORD__BACKUP.
# Instance keys are lowercase [a-z0-9][a-z0-9_-]{0,31}. Removing an instance
# from this list (or removing its variables) makes sends addressed to that
# transport id fail closed — they never silently borrow another transport.
# Only the built-in kinds can have named instances: a plugin-contributed kind
# reads its configuration from the plugin's own deployment-wide variables, so
# declaring one here has no effect and dispatching to it fails closed. A second
# declaration whose key derives the same variable suffix as an earlier one
# (`a-b` and `a_b` both give `__A_B`) is ignored for the same reason.
# SEND_TRANSPORT_INSTANCES=smtp#backup
# SMTP_RELAY_HOST__BACKUP=smtp.postmarkapp.com
# SMTP_RELAY_USERNAME__BACKUP=...
# SMTP_RELAY_PASSWORD__BACKUP=...

# Common email configuration
# DEFAULT_FROM_EMAIL=noreply@example.com
# DEFAULT_FROM_NAME=Owlat
# DEFAULT_FROM_DOMAIN=mail.owlat.app
# CONVEX_SITE_URL=https://your-deployment.convex.site
# UNSUBSCRIBE_SECRET=your-unsubscribe-secret

# --- Analytics (PostHog) ---
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://eu.i.posthog.com

# --- Translations (AI) ---
# OPENROUTER_API_KEY=sk-or-...           # Primary provider
# OPENAI_API_KEY=sk-...                  # Fallback provider

# --- CORS ---
# Allowed origins for CORS on private API endpoints (comma-separated)
# ALLOWED_ORIGINS=https://app.owlat.app,http://localhost:3000
