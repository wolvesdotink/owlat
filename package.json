{
	"name": "owlat",
	"version": "0.6.21",
	"private": true,
	"description": "Owlat — self-hosted, modular email platform: marketing campaigns, team inbox, personal mailbox, and an AI agent, gated by a single feature-flag system.",
	"keywords": [
		"convex",
		"email",
		"inbox",
		"marketing",
		"nuxt",
		"self-hosted",
		"vue"
	],
	"homepage": "https://owlat.app",
	"bugs": {
		"url": "https://github.com/wolvesdotink/owlat/issues"
	},
	"license": "Apache-2.0",
	"author": "wolves <npm@wolves.ink>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wolvesdotink/owlat.git"
	},
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*",
			"!packages/sdk-java",
			"examples/conformance",
			"examples/plugins/*"
		],
		"catalog": {
			"typescript": "^6.0.3",
			"vitest": "^5.1.0",
			"@vitest/coverage-v8": "^5.1.0",
			"@vitest/browser-playwright": "5.1.0",
			"@types/node": "^26.6.6",
			"happy-dom": "^21.0.4",
			"vue-tsc": "3.3.11"
		},
		"catalogs": {
			"vue": {
				"vue": "^3.5.45",
				"nuxt": "^4.6.4",
				"@nuxtjs/color-mode": "^4.1.0",
				"@nuxt/fonts": "^1.2.0",
				"tailwindcss": "^4.3.5",
				"@tailwindcss/vite": "^4.3.5"
			},
			"convex": {
				"convex": "^1.50.0",
				"better-auth": "1.7.15",
				"@convex-dev/better-auth": "0.12.6"
			},
			"ai": {
				"ai": "^7.0.172",
				"@ai-sdk/anthropic": "4.0.104",
				"@ai-sdk/azure": "^4.0.125",
				"@ai-sdk/google": "4.0.120",
				"@ai-sdk/openai": "^4.0.117",
				"@ai-sdk/openai-compatible": "3.0.92"
			}
		}
	},
	"scripts": {
		"setup": "bun --cwd apps/setup-cli src/index.ts quickstart",
		"dev": "bun --env-file=.env --env-file=.env.local run turbo dev --filter=@owlat/web --filter=@owlat/api",
		"dev:web": "bun --env-file=.env --env-file=.env.local run turbo dev --filter=@owlat/web",
		"dev:api": "bun --env-file=.env --env-file=.env.local run turbo dev --filter=@owlat/api",
		"dev:docs": "bun --env-file=.env --env-file=.env.local run turbo dev --filter=@owlat/docs",
		"dev:marketing": "bun --env-file=.env --env-file=.env.local run turbo dev --filter=@owlat/marketing",
		"dev:seed": "bun scripts/dev-seed.ts",
		"dev:stack": "bun scripts/dev-stack.ts",
		"capture": "bun apps/web/e2e/capture/run.ts",
		"setup:worktree": "bun scripts/setup-worktree.ts",
		"build": "turbo build",
		"build:web": "turbo build --filter=@owlat/web",
		"build:docs": "turbo build --filter=@owlat/docs",
		"build:marketing": "turbo build --filter=@owlat/marketing",
		"typecheck": "turbo typecheck && bun run typecheck:scripts",
		"typecheck:scripts": "tsc -p scripts",
		"lint": "bun run lint:warnings && bun run lint:owlat && turbo lint",
		"lint:fix": "turbo lint:fix",
		"lint:warnings": "bun scripts/check-lint-warnings.ts",
		"lint:owlat": "bash scripts/check-owlat-lint.sh",
		"lint:scripts": "oxlint --config oxlintrc.json scripts",
		"lint:script-tests": "vitest run scripts/__tests__",
		"lint:deadcode": "bash scripts/check-dead-code.sh && bash scripts/check-shared-production-exports.sh",
		"lint:catalog": "bash scripts/check-catalog-usage.sh",
		"lint:build-graph": "bun scripts/check-build-graph.ts",
		"lint:convex-orphans": "bun scripts/check-convex-plugin-orphans.ts",
		"lint:convex-globals": "bun scripts/check-convex-node-globals.ts",
		"lint:filesize": "bash scripts/check-file-size.sh",
		"lint:page-headers": "bash scripts/check-page-headers.sh",
		"lint:branding": "bash scripts/check-branding.sh",
		"lint:format": "bash scripts/check-format.sh",
		"lint:comment-policy": "bun scripts/check-comment-policy.ts",
		"lint:imports": "bash scripts/check-cross-package-imports.sh",
		"lint:providers": "bash scripts/check-provider-identity.sh",
		"lint:ui-controls": "bun scripts/check-ui-controls.ts",
		"lint:native-title": "bash scripts/check-native-title.sh",
		"lint:desktop-invoke": "bun scripts/check-desktop-invoke-contract.ts",
		"lint:tokens": "bun scripts/check-palette-classes.ts && bun scripts/check-token-contrast.ts",
		"lint:member-jargon": "bun scripts/check-member-jargon.ts",
		"lint:docker-workspaces": "bash scripts/check-docker-workspaces.sh",
		"lint:deploy-closure": "bun scripts/check-deploy-image-closure.ts",
		"lint:installer": "bash scripts/check-installer-invariants.sh",
		"lint:compose": "bash scripts/check-compose-invariants.sh",
		"lint:html-to-text": "bash scripts/check-html-to-text.sh",
		"lint:crypto-primitives": "bash scripts/check-crypto-primitives.sh",
		"lint:ast-gate-parity": "bun scripts/ast-gate-parity.ts",
		"lint:mail-services": "bash scripts/check-mail-service-guards.sh",
		"lint:source-bytes": "bash scripts/check-source-nul-bytes.sh",
		"lint:no-pr-assets": "bun scripts/check-no-pr-assets.ts",
		"lint:stored-block-corpus": "bun scripts/check-stored-block-corpus.ts",
		"lint:plugin-imports": "bun run plugins:prepare && bun packages/plugin-codegen/src/cli.ts --boundaries-only",
		"plugins:prepare": "bun run --cwd packages/provider-kit build && bun run --cwd packages/plugin-kit build",
		"plugins:codegen": "bun run plugins:prepare && bun packages/plugin-codegen/src/cli.ts",
		"plugins:check": "bun run plugins:prepare && bun packages/plugin-codegen/src/cli.ts --check",
		"plugins:test-clean": "bun packages/plugin-codegen/scripts/cleanCheckoutSmoke.ts",
		"plugins:test-api-graph": "bun packages/plugin-codegen/scripts/apiTestGraphSmoke.ts",
		"plugins:test-convex-bundle": "bun run plugins:prepare && node packages/plugin-codegen/scripts/convexBundleSmoke.ts",
		"plugins:test-convex-function-graph": "bun run plugins:prepare && bun packages/plugin-codegen/scripts/convexFunctionGraphSmoke.ts",
		"plugins:test-deploy-graph": "bun packages/plugin-codegen/scripts/deployGraphSmoke.ts",
		"deploy:api": "turbo deploy --filter=@owlat/api",
		"ox:fmt": "oxfmt --config oxfmtrc.json .",
		"ox:fmt:check": "oxfmt --config oxfmtrc.json --check .",
		"format:staged": "bun scripts/format-staged.ts",
		"hooks:install": "bun scripts/install-git-hooks.ts",
		"hooks:uninstall": "bun scripts/install-git-hooks.ts --uninstall",
		"check:changed": "bun scripts/check-changed.ts",
		"ci:report": "bun scripts/ci/report.ts",
		"ci:lint": "bash scripts/ci-gate.sh lint",
		"ci:typecheck": "turbo typecheck --filter='!@owlat/desktop' && bun run typecheck:scripts",
		"ci:test": "turbo test --filter='!@owlat/desktop'",
		"ci:test:coverage": "turbo test:coverage --filter='!@owlat/desktop'",
		"ci:verify": "bash scripts/ci-gate.sh verify",
		"test": "turbo test",
		"test:watch": "turbo test:watch",
		"test:ramp": "bun run --cwd apps/api test:ramp",
		"perf:bench": "bun scripts/perf-bench/run.ts",
		"goldens:update": "bun --cwd packages/mail-message run goldens:update",
		"release:cut": "bun scripts/release.ts",
		"release:promote": "bun scripts/release-promote.ts",
		"release:push": "bun scripts/release-push.ts"
	},
	"dependencies": {
		"nuxt": "4.6.4",
		"vite": "8.3.8"
	},
	"devDependencies": {
		"knip": "6.23.0",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"turbo": "^2.11.11"
	},
	"overrides": {
		"@ai-sdk/provider-utils": "^5.0.81",
		"@babel/core": "^7.29.13",
		"@nuxt/devtools": "^3.4.4",
		"better-auth": "1.7.15",
		"brace-expansion": "^5.0.13",
		"browserslist": "^4.29.5",
		"dompurify": "^3.4.17",
		"fast-xml-builder": "^1.3.1",
		"fflate": "^0.8.3",
		"hono": "^4.13.18",
		"ip-address": "^10.7.6",
		"joi": "^18.3.2",
		"js-cookie": "^3.0.8",
		"js-yaml": "^4.3.2",
		"launch-editor": "^2.14.2",
		"linkify-it": "^5.0.2",
		"node-forge": "^1.4.3",
		"nodemailer": "10.5.0",
		"nuxt": "4.6.4",
		"nuxt-og-image": "7.0.7",
		"postcss": "^8.5.32",
		"postcss-selector-parser": "^7.2.1",
		"protobufjs": "^7.6.6",
		"sanitize-html": "^2.18.2",
		"sharp": "0.35.5",
		"shell-quote": "^1.12.0",
		"smol-toml": "^1.9.1",
		"socket.io-parser": "^4.2.7",
		"svgo": "^4.1.0",
		"tar": "^7.5.23",
		"tmp": "^0.2.7",
		"valibot": "^1.5.0",
		"vite": "8.3.8",
		"ws": "^8.23.0"
	},
	"packageManager": "bun@1.4.4",
	"patchedDependencies": {
		"groupmq@1.1.0": "patches/groupmq@1.1.0.patch",
		"@convex-dev/better-auth@0.12.6": "patches/@convex-dev%2Fbetter-auth@0.12.6.patch"
	},
	"trustedDependencies": [
		"@owlat/ui"
	]
}
