# Dependencies
node_modules/
.pnp
.pnp.js

# Build
.next/
out/
build/
dist/
.nuxt/
.output/
.turbo/
# Symlinks to build output (-> .output/public); the `dist/` pattern above only
# matches directories, not these symlinks.
/apps/web/dist
/apps/docs/dist
/apps/marketing/dist

# Environment
.env
.env.local
.env.selfhost
.env.development.local
.env.test.local
.env.production.local
.owlat-provisioning.json
.owlat-provisioning.json.*.tmp
# The updater's record of the last in-app update (served on its /health).
.owlat-last-rollout.json
.owlat-last-rollout.json.tmp

# Secrets / keys (must never be committed)
*.key
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing
coverage/
# `bun run perf:bench` reports and raw samples (scripts/perf-bench/run.ts).
/.perf-bench/
.nyc_output/
# The send-provider scaffold's conformance gate materialises the generator's
# output here (rather than under /tmp) so the emitted package resolves `vitest`
# and runs its own suite the way an author's would. The suite removes it; this
# keeps an interrupted run from dirtying the tree.
/examples/conformance/.scaffolded/
# `schema-compat:refresh` extracts a release's convex/ tree here so its imports
# resolve against this package, and removes it when done.
/apps/api/.schema-compat/
.auth/
playwright-report/
test-results/

# Prisma
prisma/*.db

# Ralph
scripts/ralph/.last-branch
scripts/ralph/archive/

# Convex (keep _generated/ tracked so Docker builds work without Convex credentials)
# convex/_generated/

.data/

# Email preview output (packages/email-renderer/src/preview/generate.ts).
# Anchored so it does not hide the email-builder's tracked previews/ components
# from tools that read .gitignore (knip drops ignored files from its graph).
/packages/email-renderer/previews/

# Review reports & internal working notes — kept uncommitted by convention.
# Root-level only (the leading slash), so documentation under apps/docs is
# unaffected. Plans and pipelines are written as either Markdown or a
# self-contained HTML page, hence both extensions.
/*_REVIEW_*.md
/*_REVIEW_*.html
/*_AUDIT_*.md
/*_AUDIT_*.html
/*_PLAN_*.md
/*_PLAN_*.html
# Scratch plans written during a session; never product content.
/*-plan.html
/*-pipeline.html

# Plans and PR evidence belong in the issue or PR that owns them, and the
# mock-Convex screenshot harness is local scaffolding. `lint:no-pr-assets`
# (scripts/check-no-pr-assets.ts) fails on tracked files under these paths, so
# a force-add does not get past this list either.
/docs/plans/
/docs/ui-polish/
/docs/ux-plan/
/docs/screenshots/
/scripts/uiaudit/
/apps/web/app/lib/uiMock/

# Playwright MCP session artifacts (distinct from playwright-report/ above)
.playwright-mcp/

# Local smoke-test configs (secret-shaped values; never stage them)
/.owlat-*

# AI
.planning/
.claude/
.agents/

# Pipeline worktrees (the builder/reviewer skills check branches out here).
.worktrees/

# CI verification and sharded test artifacts
.ci-verification/
**/.ci-shards/
**/.ci-downloads/
**/.vitest-reports/
