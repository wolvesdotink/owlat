     )
     redis.call("ZADD", failedKey, timestamp, jobId)
-    
-    -- Note: No retention trimming for failed jobs (let clean() handle it)
+
+    -- Trim old entries atomically, exactly as the `completed` branch above does.
+    --
+    -- Upstream left this branch untrimmed ("let clean() handle it"), which makes
+    -- `keepFailed` silently inert for anyone who never schedules `clean()` — and
+    -- nothing in this repository calls it. `<ns>:failed` and every failed job's
+    -- hash then grow forever, and a failed job hash holds the whole EmailJob
+    -- payload, `html` included, so this is bytes and not merely key count. Since
+    -- the Redis this queue lives on runs `--maxmemory` with
+    -- `maxmemory-policy noeviction`, unbounded growth is not bloat but an
+    -- outage with a fuse on it: at the cap Redis refuses writes and the MTA
+    -- stops accepting mail.
+    --
+    -- Trimmed here rather than from a sweeper so the retention contract stays
+    -- atomic with the write that creates the thing it bounds: no interval, no
+    -- leader election and no second code path can fail to run, and `keepFailed`
+    -- means what its name and the option's own docs say it means.
+    --
+    -- Deleted in a loop rather than with `DEL unpack(oldIds)` (the shape the
+    -- `completed` branch uses) to match `complete-with-metadata.lua` and to keep
+    -- a large trim off the Lua stack.
+    local failedCount = redis.call("ZCARD", failedKey)
+    local toRemoveFailed = failedCount - keepFailed
+    if toRemoveFailed > 0 then
+      local oldFailedIds = redis.call("ZRANGE", failedKey, 0, toRemoveFailed - 1)
+      if #oldFailedIds > 0 then
+        redis.call("ZREMRANGEBYRANK", failedKey, 0, toRemoveFailed - 1)
+        for i = 1, #oldFailedIds do
+          local oldId = oldFailedIds[i]
+          redis.call("DEL", ns .. ":job:" .. oldId)
+          redis.call("DEL", ns .. ":unique:" .. oldId)
+        end
+      end
+    end
   else
     -- keepFailed == 0: Delete immediately (batch operation)
     redis.call("DEL", jobKey, ns .. ":unique:" .. jobId)
