 local gZ = ns .. ":g:" .. gid
+
+-- Skip chaining while the group's head is still delayed. A delayed job sits in
+-- BOTH the group ZSET and the :delayed ZSET, so popping it here would hand the
+-- worker a job before its runAt AND strand its :delayed entry forever, because
+-- only the promoter removes that entry. Every other reservation path already
+-- makes this check (reserve.lua, reserve-atomic.lua, reserve-batch.lua); the
+-- promoter will make this job ready at its runAt.
+local delayedHead = redis.call("ZRANGE", gZ, 0, 0)
+if delayedHead and #delayedHead > 0 then
+  local headStatus = redis.call("HGET", ns .. ":job:" .. delayedHead[1], "status")
+  if headStatus == "delayed" then
+    return nil
+  end
+end
+
 local zpop = redis.call("ZPOPMIN", gZ, 1)
 if not zpop or #zpop == 0 then
   -- Clean up empty group
