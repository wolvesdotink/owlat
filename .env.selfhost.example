# ═══════════════════════════════════════════════════════════════════════════════
# Owlat Self-Hosted Configuration
# Audience: operators deploying the stack with Docker Compose. (Contributors
# hacking on Owlat itself with `bun run dev` want .env.example instead.)
# Copy this to .env and fill in the values before running docker compose up
# ═══════════════════════════════════════════════════════════════════════════════

# ── Convex Backend ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
INSTANCE_SECRET=

# The PREVIOUS INSTANCE_SECRET, set ONLY during a secret-rotation window (Sealed
# Mail). While set, sealed private keys still encrypted under the old secret keep
# opening (fallback) so the vault reads correctly while the re-seal migration
# (Settings → Sealed Mail) runs. Remove it once the migration has completed.
# INSTANCE_SECRET_PREVIOUS=

# Generated after first boot via: docker compose exec convex ./generate_admin_key.sh
# Required for deploying functions and setting Convex env vars
CONVEX_ADMIN_KEY=

# Optional least-privilege key for the untrusted code-worker sidecar. When set it
# is used INSTEAD of CONVEX_ADMIN_KEY for that container only (poll/claim/complete
# of codeWorkTasks), so the full admin key need not enter the untrusted executor.
# Convex self-hosted cannot yet mint a per-function scoped key, so this is a seam
# for a narrower key (e.g. a reverse proxy allowlisting the codeWorkTasks
# endpoints). Leave blank to fall back to CONVEX_ADMIN_KEY.
# CODE_WORKER_CONVEX_KEY=

# ── Public URLs ───────────────────────────────────────────────────────────────
# These must be reachable from the user's browser.
# NOTE: there is no CONVEX_SITE_URL knob here — it is a Convex BUILT-IN that the
# backend derives from NUXT_PUBLIC_CONVEX_SITE_URL (via CONVEX_SITE_ORIGIN on the
# convex container). `convex env set CONVEX_SITE_URL` is rejected
# (EnvVarNameForbidden), so set the public URL below and nowhere else.
NUXT_PUBLIC_CONVEX_URL=http://localhost:3210
NUXT_PUBLIC_CONVEX_SITE_URL=http://localhost:3211
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Convex function-runtime variables ────────────────────────────────────────
# These are read by Convex *functions*, not the compose containers. The
# `owlat quickstart` wizard generates/derives them and pushes them INTO the
# Convex deployment for you. If you are installing entirely by hand, set each one
# with `convex env set` after deploying functions (see the Option B sequence in
# docs/developer/self-hosting) — leaving them blank boots a backend that cannot
# log anyone in or send a single email.
#
# Auth + unsubscribe signing secrets. Generate each with: openssl rand -base64 32
BETTER_AUTH_SECRET=
UNSUBSCRIBE_SECRET=
# Public site URL for auth redirects (match NUXT_PUBLIC_SITE_URL above).
SITE_URL=http://localhost:3000
# In-cluster MTA address. REQUIRED for every send — including auth/system mail on
# resend/ses installs — or sending hard-throws "No system email transport configured".
MTA_API_URL=http://mta:3100
# Optional VPS provider hint (hetzner, digitalocean, ovh, vultr, linode,
# scaleway, aws, contabo). Only used to print a short port-25 note when the
# setup doctor finds outbound TCP/25 blocked; unset simply prints the generic one.
# MTA_VPS_PROVIDER=
# Default sender identity for system mail (invitations, password resets, …).
DEFAULT_FROM_EMAIL=noreply@example.com
DEFAULT_FROM_NAME=Owlat
DEFAULT_FROM_DOMAIN=example.com

# ── Operating mode: delivery provider + active services ─────────────────────
# The built-in MTA is now an opt-in service (the `mta` compose profile). For the
# default self-host the MTA is both the delivery provider and the inbound MX, so
# keep `mta` in COMPOSE_PROFILES. Switch to a third-party provider
# (EMAIL_PROVIDER=resend|ses|smtp|mandrill, with its credentials below) and drop `mta`
# here to stop running it. Add other profiles (personal-mail, external-mail, ai, clamav)
# as you enable those features — the setup CLI/wizard manages this for you.
EMAIL_PROVIDER=mta
COMPOSE_PROFILES=mta

# ── MTA Configuration (only when EMAIL_PROVIDER=mta or postbox/inbox enabled) ──
# Generate with: openssl rand -base64 32
MTA_API_KEY=
MTA_WEBHOOK_SECRET=
# Seals DKIM private keys + relay credentials at rest (>= 32 bytes; the MTA
# refuses to boot otherwise). Keep it STABLE across restarts — rotating it
# strands already-sealed values. Generate with: openssl rand -hex 32
MTA_SECRET=

# Must match your server's rDNS PTR record
EHLO_HOSTNAME=mail.example.com

# Optional JSON map for multi-IP deployments where each address has its own PTR:
# EHLO_HOSTNAMES={"203.0.113.10":"mail1.example.com","203.0.113.11":"mail2.example.com"}

# Optional comma-separated provider-default PTR suffixes to warn about in
# addition to Owlat's built-in data list. Hostname suffixes only (not regexes).
# MTA_GENERIC_PTR_SUFFIXES=static.example-vps.net,customer.example-host.net

# LAB USE ONLY. Production defaults fail closed: an IP without verified PTR → A
# alignment is quarantined and never selected. The dashboard still reports the
# failed verdict when this explicit bypass is enabled.
MTA_ALLOW_UNVERIFIED_FCRDNS=false

# Domain for VERP bounce return-path addresses
RETURN_PATH_DOMAIN=bounces.example.com

# Secret that signs the VERP bounce token (BATV/HMAC) so forged DSNs cannot
# poison the suppression list. Required at startup; generate with
# `openssl rand -base64 32` and keep it stable across restarts.
# ONE secret, two readers: setup PROJECTS this into the backend as
# MTA_BOUNCE_VERP_KEY (and RETURN_PATH_DOMAIN as MTA_RETURN_PATH_DOMAIN) so relay
# sends can carry the same signed envelope sender. Never hand-copy it into a
# second variable — a typo there mints tokens the MTA will never verify.
BOUNCE_VERP_KEY=

# SPF mechanism terms that authorise a third-party RELAY to send with a
# bounce+...@<return-path host> envelope sender (space- or comma-separated;
# include:/a:/mx:/ip4:/ip6: only, anything else is ignored, at most 5 terms).
# The generated return-path SPF record authorises the MTA pool IPs, so without
# these a relay would fail SPF on the bounce domain: the VERP stamp stays OFF,
# relay sends keep the composer's envelope sender and that arm is graded
# degraded-measurement. Set your relay's published include, re-verify the domain
# so the record is republished, and the stamp turns itself on. These terms ADD to
# the pool authorisation rather than replacing it — with no IP pool there is no
# return-path record to add them to, so configure the pool first.
# Unset changes nothing and blocks nothing.
# MTA_RETURN_PATH_RELAY_SPF=include:relay.example.net

# Comma-separated IP addresses for sending pools. Outbound IPv6 is deliberately
# opt-in; read the self-hosting DNS guide before changing this to true.
MTA_IPV6_ENABLED=false
IP_POOLS_TRANSACTIONAL=127.0.0.1
IP_POOLS_CAMPAIGN=127.0.0.1

# JSON object: {"example.com":{"selector":"s1","privateKey":"-----BEGIN RSA..."}}
DKIM_KEYS={}

# BIMI — your brand logo beside the message in supporting mail clients. Optional
# in every sense: once a sending domain's DMARC is at p=quarantine or stricter
# the domain wizard OFFERS a BIMI record, and with these unset it explains what
# BIMI and a VMC are and generates nothing. Setting them never blocks a send, a
# warm-up or a verification — a missing logo is just a missing logo.
# MTA_BIMI_LOGO_URL is the HTTPS URL of your SVG Tiny PS logo (the `l=` tag),
# MTA_BIMI_VMC_URL the HTTPS URL of your Verified Mark Certificate PEM (the `a=`
# tag) — Gmail and Apple Mail display the logo only with a VMC, other receivers
# show it from the record alone. Both must be plain HTTPS URLs; a value that is
# not one is ignored and the wizard says which one to fix rather than publishing
# a record that does not parse. MTA_BIMI_SELECTOR names the record host
# (<selector>._bimi.<domain>); unset means the spec's `default`.
# MTA_BIMI_LOGO_URL=https://example.com/brand/logo.svg
# MTA_BIMI_VMC_URL=https://example.com/brand/vmc.pem
# MTA_BIMI_SELECTOR=default

# MTA tuning (optional)
WORKER_CONCURRENCY=50
MTA_LOG_LEVEL=info
# Max unresolved SMTP outcome reservations retained before new SMTP attempts defer
SMTP_OUTCOME_JOURNAL_MAX_SIZE=10000
# Complaint deduplication has no safe automatic legacy upgrade. For a genuinely
# fresh Redis/install, set owned-v2 + fresh-install. Existing installations must
# follow the quiesced cutover procedure in the MTA system docs and acknowledge
# with quiesced-v1-intake instead. Blank values make copied upgrade configs fail
# closed rather than silently mixing legacy and owned-v2 workers.
FBL_DEDUP_PROTOCOL=
FBL_DEDUP_CUTOVER_ACK=
# Outbound TLS posture for direct-MX delivery (RFC 7435/8461/9325):
#   opportunistic (default), require, or require-verified.
# require-verified can bounce mail to receivers with a broken/self-signed
# certificate. Per-domain overrides: the master-key-protected /outbound-tls API.
OUTBOUND_TLS_MODE=opportunistic
# DANE / TLSA at send time (RFC 7672). DANE_MODE is one of:
#   off      no TLSA lookups (historic behaviour);
#   report   (default) look up + evaluate the MX's DNSSEC-validated TLSA RRset and
#            REPORT the result in TLS-RPT (success / validation-failure under the
#            tlsa policy), but never require TLS or bounce — delivery proceeds on
#            the normal opportunistic/MTA-STS decision (observability only, D6);
#   enforce  authenticate the MX cert against the RRset (supersedes MTA-STS; a
#            non-match defers the message, never cleartext).
# report/enforce both need a VALIDATING DoH resolver over https:// (http:// only
# for a loopback resolver) — the AD bit is trusted, so the channel must be
# unforgeable. WITHOUT DANE_RESOLVER_URL, DANE is inert in every mode, so a fresh
# install behaves exactly as before. A lookup that fails (SERVFAIL/timeout) defers
# under enforce (a no-op under report) rather than downgrading. Running a local
# validating resolver is the recommended production setup.
# DANE_MODE=report
# DANE_RESOLVER_URL=https://127.0.0.1:8443/dns-query

# ── Generic SMTP relay (only when EMAIL_PROVIDER=smtp) ───────────────────────
# Send through any SMTP submission host — Mailgun, Postmark, SendGrid, Brevo, or
# a custom relay. The relay owns the sending IPs and DKIM signing, so configure
# SPF/DKIM for your From-domain in the relay's dashboard (not via the MTA DNS
# bundle). Drop `mta` from COMPOSE_PROFILES when you rely on a relay.
# SMTP_RELAY_HOST=smtp.mailgun.org
# SMTP_RELAY_PORT=587           # 587 = STARTTLS (default); 465 = implicit TLS
# SMTP_RELAY_SECURE=false       # "true" only for implicit TLS on 465
# SMTP_RELAY_USERNAME=
# A plaintext value works; Owlat setup (CLI wizard, `owlat-setup env`) and the
# in-app transport editor store this SEALED at rest (an `envsealed:v1:…` token
# encrypted under INSTANCE_SECRET) and the deploy step unseals it automatically
# — don't edit a sealed token by hand, just replace it with the new plaintext
# password.
# SMTP_RELAY_PASSWORD=

# ── Mailchimp Transactional / Mandrill (only when EMAIL_PROVIDER=mandrill) ───
# The migration arm: arrive from Mailchimp still sending through your existing
# Mandrill account, then let Owlat's ramp controller move traffic onto the
# built-in MTA cell by cell. Owlat composes the whole MIME message itself and
# posts it to messages/send-raw with Mandrill's open/click tracking, link
# rewriting and auto-text OFF — tracking is first-party, so both arms are
# measured on identical instrumentation. Keep `mta` in COMPOSE_PROFILES for a
# migration; drop it only once every cell has graduated.
# MANDRILL_API_KEY=
# Per-webhook signing key, shown by Mandrill once you create a webhook pointing
# at <CONVEX_SITE_URL>/webhooks/mandrill. Enable send, deferral, hard_bounce,
# soft_bounce, spam, unsub and reject — NOT open/click. Without it there is no
# verified feedback loop and this arm's bounces never reach Owlat.
# MANDRILL_WEBHOOK_KEY=
# Optional: isolate Owlat's traffic (and its reputation) inside a shared
# Mandrill account.
# MANDRILL_SUBACCOUNT=
# Optional: default dedicated-IP pool name. A provider route's own ipPool
# overrides it per send.
# MANDRILL_IP_POOL=

# ── Additional NAMED transport instances (optional) ──────────────────────────
# Every transport kind already has one default instance reading the unsuffixed
# variables above. Declare extra ones as a comma-separated `<kind>#<instanceKey>`
# list when you want two configurations of the SAME kind side by side — e.g.
# keeping a warm fallback relay while trialling a second one. Each named instance
# reads its kind's variables suffixed with `__<INSTANCEKEY>`, so `smtp#backup`
# reads SMTP_RELAY_HOST__BACKUP / SMTP_RELAY_USERNAME__BACKUP / …
# Instance keys are lowercase [a-z0-9][a-z0-9_-]{0,31}. Removing an instance from
# this list (or removing its variables) makes sends addressed to that transport
# id fail closed — they never silently borrow another transport. Only built-in
# kinds can have named instances: a plugin-contributed kind reads its own
# deployment-wide variables, so declaring one here has no effect and dispatching
# to it fails closed. A second declaration whose key derives the same suffix as
# an earlier one (`a-b` and `a_b` both give `__A_B`) is ignored for that reason.
# Unset ⇒ one transport per kind, the default self-host.
#
# THE INSTANCE'S CREDENTIALS DO NOT GO IN THIS FILE. `owlat quickstart` and the
# setup wizard push a FIXED list of function-runtime variables (see the section
# header above), and the `__<INSTANCEKEY>` names cannot be on it — the suffix is
# yours to invent, so nothing can enumerate them ahead of time. Declare the
# instance here and set its credentials against the deployment itself, after
# deploying functions:
#   convex env set SMTP_RELAY_HOST__BACKUP smtp.postmarkapp.com
#   convex env set SMTP_RELAY_USERNAME__BACKUP ...
#   convex env set SMTP_RELAY_PASSWORD__BACKUP ...
# A declared instance whose credentials never arrived fails closed on the first
# send addressed to it, exactly like one whose variables were removed.
# SEND_TRANSPORT_INSTANCES=smtp#backup

# ── Microsoft SNDS (optional external reputation signal) ─────────────────────
# Comma- or whitespace-separated "Automated Data Access" feed URLs from the
# Microsoft SNDS portal, one per registered IP range (https only). Owlat polls
# them every six hours and stores the per-IP, per-day complaint BAND, filter
# result and spam-trap hits — Microsoft publishes bands, not rates, and Owlat
# keeps them as bands rather than inventing a percentage.
# Each URL is a bearer capability to your SNDS data: keep it secret.
# Leave this unset if you have not enrolled. That is a supported configuration:
# the Microsoft ramp then relies on SMTP reply classification, dwells twice as
# long before advancing and caps one phase lower. Nothing errors or nags.
# SNDS_DATA_FEED_URLS=https://sendersupport.olc.protection.outlook.com/snds/ada/...

# ── Redis (internal-only; password is defense-in-depth) ─────────────────────
# REQUIRED. Compose fails closed on an unset OR empty value rather than falling
# back to a known literal, and it interpolates the whole file before selecting
# services — so until this is set, `docker compose down|logs|ps` abort too, not
# just `up`. `owlat-setup` and `bash scripts/setup.sh` generate one for you.
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=

# ── Port Overrides (optional) ────────────────────────────────────────────────
# Convex, the MTA HTTP API, and the dashboard bind to 127.0.0.1 by default;
# Redis and ClamAV publish no host port at all. Front the stack with the
# `tls` profile (Caddy) for remote access. CONVEX_BIND=0.0.0.0 exposes the
# backend raw — only do that behind your own firewall/proxy.
# CONVEX_BIND=127.0.0.1
# CONVEX_PORT=3210
# CONVEX_SITE_PORT=3211
# DASHBOARD_PORT=6791   # requires: docker compose --profile dashboard up -d
# WEB_PORT=3000
# MTA_HTTP_PORT=3100
# MTA_SMTP_PORT=25
# IMAP_PORT=993

# ── PostHog Analytics (optional) ─────────────────────────────────────────────
# NUXT_PUBLIC_POSTHOG_API_KEY=
# NUXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── Local LLM / Ollama (optional, --profile dev) ──────────────────────────────
# Run AI inference on your own hardware instead of a hosted provider. Bring up
# the bundled `ollama` service with: docker compose --profile dev up -d ollama
# It is reachable only on the internal Docker network as ollama:11434 (no host
# port). Pin the image tag here if you don't want :latest:
# OLLAMA_VERSION=latest
#
# Then point the agent pipeline at it. These are Convex *function* env vars —
# set them on the backend with `convex env set` (not in this compose .env):
#   LLM_PROVIDER=ollama
#   LLM_BASE_URL=http://ollama:11434/v1   # auto-resolved when LLM_PROVIDER=ollama
# No LLM_API_KEY is required for Ollama.
#
# EMBEDDINGS (local-by-default plane): retrieval / knowledge graph / semantic
# search resolve embeddings INDEPENDENTLY of the language provider, so they work
# even under a language provider with no embeddings API (e.g. Anthropic). Point
# them at a local OpenAI-compatible /embeddings sidecar — again Convex env vars:
#   LOCAL_EMBEDDING_BASE_URL=http://ollama:11434/v1
#   LOCAL_EMBEDDING_MODEL=nomic-embed-text
# NOTE: the local model's native vector width must match the fixed vector index
# (EMBEDDING_DIMENSIONS, 1536). nomic-embed-text is 768-dim — either run a
# 1536-dim model or change EMBEDDING_DIMENSIONS and re-index; the dimension guard
# rejects a mismatched vector rather than silently corrupting search.

# ── Deployment Mode ──────────────────────────────────────────────────────────
# Tells the web app whether to show the self-host onboarding banner or hide
# hosted-only UI (billing, upgrade prompts). Leave as "selfhost" unless you're
# running the managed cloud offering.
OWLAT_DEPLOYMENT_MODE=selfhost

# ── Install Directory (required for in-app updates) ──────────────────────────
# Absolute path to this repo on the host. The updater sidecar mounts this to
# write compose templates and run `docker compose pull && up -d`. Defaults to
# the current directory (works with `docker compose up -d` from the repo root).
# OWLAT_INSTALL_DIR=/opt/owlat

# ── Version Metadata (set by release pipeline — do not edit manually) ────────
# OWLAT_VERSION=dev
# OWLAT_GIT_SHA=unknown
# OWLAT_BUILD_DATE=unknown
