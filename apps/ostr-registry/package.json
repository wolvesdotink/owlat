{
	"name": "@owlat/ostr-registry",
	"version": "0.4.4",
	"private": true,
	"description": "OSTR registry node: embedded append-only Merkle transparency log behind an RFC 9162-shaped API, reference aggregator running the open scoring policy, DNS zone generation, signed snapshots + diff feed, and the HTTPS query API. Deployable standalone.",
	"homepage": "https://owlat.app",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --config ../../oxlintrc.json --ignore-pattern '**/__tests__/**' src",
		"lint:fix": "oxlint --config ../../oxlintrc.json --ignore-pattern '**/__tests__/**' src --fix",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage --passWithNoTests"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.0",
		"@owlat/ostr-core": "workspace:*",
		"better-sqlite3": "^13.0.3",
		"hono": "^4.13.1",
		"pino": "^10.3.1"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "catalog:",
		"tsx": "^4.19.0",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
