{
	"name": "@owlat/mta",
	"version": "0.6.21",
	"private": true,
	"description": "Owlat custom MTA - direct SMTP delivery with intelligent rate control",
	"homepage": "https://owlat.app",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
		"lint": "oxlint --config ../../oxlintrc.json src && bun scripts/check-env-example.ts && bash ../api/scripts/check-env.sh src config.ts monitoring/logger.ts",
		"lint:fix": "oxlint --config ../../oxlintrc.json src --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.8",
		"@owlat/email-scanner": "workspace:*",
		"@owlat/mail-auth": "workspace:*",
		"@owlat/mail-message": "workspace:*",
		"@owlat/mta-protocol": "workspace:*",
		"@owlat/shared": "workspace:*",
		"@owlat/smtp-client": "workspace:*",
		"@owlat/smtp-listener": "workspace:*",
		"@owlat/worker-protocol": "workspace:*",
		"convex": "catalog:convex",
		"groupmq": "^1.1.0",
		"hono": "^4.13.18",
		"ioredis": "^6.0.0",
		"pino": "^10.4.0",
		"prom-client": "^15.1.3"
	},
	"devDependencies": {
		"@types/mailparser": "^3.9.0",
		"@types/node": "catalog:",
		"ioredis-mock": "^8.13.1",
		"mailauth": "^8.0.6",
		"mailparser": "3.9.39",
		"smtp-server": "^3.21.4",
		"tsx": "^4.23.15",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
