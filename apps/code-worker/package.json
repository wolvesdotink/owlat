{
	"name": "@owlat/code-worker",
	"version": "0.5.0",
	"private": true,
	"license": "Apache-2.0",
	"homepage": "https://owlat.app",
	"type": "module",
	"exports": {
		"./jobs/seedTest": "./src/jobs/seedTest.ts",
		"./pluginTaskRunner": "./src/pluginTaskRunner.ts"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"start": "node dist/index.js",
		"lint": "oxlint --config ../../oxlintrc.json src",
		"lint:fix": "oxlint --config ../../oxlintrc.json src --fix",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage --passWithNoTests"
	},
	"dependencies": {
		"convex": "catalog:convex",
		"@octokit/rest": "^22.0.1",
		"@owlat/plugin-kit": "workspace:*",
		"execa": "^10.0.1"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"tsx": "^4.19.0",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
