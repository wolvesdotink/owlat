{
	"name": "@owlat/web",
	"version": "0.6.21",
	"private": true,
	"homepage": "https://owlat.app",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "bun --env-file=../../.env --env-file=../../.env.local run nuxt dev",
		"dev:desktop": "bun --env-file=../../.env --env-file=../../.env.local run cross-env OWLAT_DESKTOP=true nuxt dev",
		"dev:typecheck": "cross-env NUXT_TYPECHECK=true nuxt dev",
		"build": "nuxt build",
		"generate": "nuxt generate",
		"generate:desktop": "cross-env OWLAT_DESKTOP=true NUXT_PUBLIC_CONVEX_URL= NUXT_PUBLIC_CONVEX_SITE_URL= nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"typecheck": "cross-env NODE_OPTIONS=--max-old-space-size=8192 nuxt typecheck && tsc -p e2e/tsconfig.json && tsc -p perf/tsconfig.json",
		"lint": "oxlint --config ../../oxlintrc.json app server e2e scripts perf && bash scripts/check-dead-tokens.sh && bash scripts/check-localized-text.sh",
		"lint:localized-text": "bash scripts/check-localized-text.sh",
		"lint:fix": "oxlint --config ../../oxlintrc.json app server e2e scripts perf --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:browser": "vitest run --config vitest.browser.config.ts",
		"test:e2e": "playwright test --config=e2e/playwright.config.ts",
		"test:e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
		"test:e2e:headed": "playwright test --config=e2e/playwright.config.ts --headed",
		"perf:scenarios": "bun perf/run.ts",
		"perf:gate": "bun perf/run.ts --repeats 3"
	},
	"dependencies": {
		"@convex-dev/better-auth": "catalog:convex",
		"@coolicons/vue": "^5.3.0",
		"@nuxtjs/color-mode": "catalog:vue",
		"@nuxtjs/i18n": "^10.6.0",
		"@owlat/api": "workspace:*",
		"@owlat/email-builder": "workspace:*",
		"@owlat/email-renderer": "workspace:*",
		"@owlat/plugin-host": "workspace:*",
		"@owlat/plugin-kit": "workspace:*",
		"@owlat/shared": "workspace:*",
		"@owlat/worker-protocol": "workspace:*",
		"@tailwindcss/vite": "catalog:vue",
		"better-auth": "catalog:convex",
		"convex": "catalog:convex",
		"d3-force": "^3.0.1",
		"nuxt": "catalog:vue",
		"nuxt-security": "^2.7.0",
		"papaparse": "^5.7.1",
		"posthog-js": "^1.448.0",
		"sanitize-html": "^2.18.2",
		"uqr": "^0.1.3",
		"vue": "catalog:vue",
		"vue-draggable-plus": "^0.6.1",
		"vue-router": "^5.5.0"
	},
	"devDependencies": {
		"@nuxt/fonts": "catalog:vue",
		"@owlat/ui": "workspace:*",
		"@playwright/test": "^1.65.0",
		"@types/d3-force": "^3.0.10",
		"@types/node": "catalog:",
		"@types/papaparse": "^5.5.2",
		"@types/sanitize-html": "^2.16.2",
		"@vitejs/plugin-vue": "^6.0.11",
		"@vitest/browser-playwright": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"@vue/test-utils": "^2.5.1",
		"axe-core": "^4.14.0",
		"cross-env": "^10.1.0",
		"fake-indexeddb": "^6.2.8",
		"fflate": "^0.8.3",
		"happy-dom": "catalog:",
		"tailwindcss": "catalog:vue",
		"typescript": "catalog:",
		"undici": "^8.12.4",
		"vite": "8.3.8",
		"vitest": "catalog:",
		"vue-i18n": "^11.4.19",
		"vue-tsc": "catalog:"
	}
}
