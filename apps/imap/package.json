{
	"name": "@owlat/imap",
	"version": "0.6.21",
	"private": true,
	"description": "Owlat IMAP server (port 993). Translates IMAP4rev1 commands into Convex queries against per-user mailboxes.",
	"homepage": "https://owlat.app",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
		"lint": "oxlint --config ../../oxlintrc.json src && bash ../api/scripts/check-env.sh src config.ts logger.ts",
		"lint:fix": "oxlint --config ../../oxlintrc.json src --fix",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@owlat/mail-message": "workspace:*",
		"@owlat/shared": "workspace:*",
		"@owlat/worker-protocol": "workspace:*",
		"convex": "catalog:convex",
		"ioredis": "^6.0.0",
		"pino": "^10.4.0"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"imapflow": "^2.11.0",
		"ioredis-mock": "^8.13.1",
		"tsx": "^4.23.15",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
