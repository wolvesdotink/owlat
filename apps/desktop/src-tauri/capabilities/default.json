{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Core capability for the main + compose windows: window control, notifications, deep links, updater, shell-open, the workspace store, and the app commands every window uses (src/ipc_commands.rs WINDOW_COMMANDS). Server provisioning is granted to the main window only (provisioning.json).",
	"windows": ["main", "compose"],
	"permissions": [
		"core:default",
		"core:window:allow-show",
		"core:window:allow-hide",
		"core:window:allow-set-focus",
		"core:window:allow-unminimize",
		"core:window:allow-start-dragging",
		"core:window:allow-minimize",
		"core:window:allow-toggle-maximize",
		"core:window:allow-close",
		"core:window:allow-is-maximized",
		"core:window:allow-set-title",
		"core:window:allow-set-theme",
		"core:window:allow-set-effects",
		"core:event:default",
		"notification:default",
		"deep-link:default",
		"updater:default",
		"shell:allow-open",
		"store:default",
		"autostart:allow-enable",
		"autostart:allow-disable",
		"autostart:allow-is-enabled",
		"global-shortcut:allow-register",
		"global-shortcut:allow-unregister",
		"global-shortcut:allow-is-registered",
		"allow-update-unread-badge",
		"allow-send-native-notification",
		"allow-send-actionable-notification",
		"allow-secret-get",
		"allow-session-secret-read",
		"allow-session-secret-write",
		"allow-session-secret-replace",
		"allow-pick-files",
		"allow-read-authorized-file",
		"allow-open-compose",
		"allow-set-traffic-lights-visible",
		"allow-set-accent-frame",
		"allow-window-ready",
		"allow-titlebar-double-click",
		"allow-zoom-level",
		"allow-updater-check",
		"allow-updater-install",
		"allow-updater-restart",
		"allow-updater-notify-ready"
	]
}
