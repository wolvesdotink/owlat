{
	"name": "@owlat/updater",
	"version": "0.4.4",
	"private": true,
	"homepage": "https://owlat.app",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "bun build src/index.ts --target=node --outdir=dist",
		"typecheck": "tsc --noEmit",
		"start": "node dist/index.js",
		"lint": "oxlint --config ../../oxlintrc.json --ignore-pattern '**/__tests__/**' src",
		"lint:fix": "oxlint --config ../../oxlintrc.json --ignore-pattern '**/__tests__/**' src --fix",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage --passWithNoTests"
	},
	"dependencies": {
		"@owlat/shared": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^26.0.1",
		"tsx": "^4.19.0",
		"typescript": "^7.0.2",
		"vitest": "catalog:"
	}
}
