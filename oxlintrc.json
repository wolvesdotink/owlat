{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["import", "typescript", "unicorn"],
	// Owlat's own rules (packages/oxlint-plugin-owlat). oxlint resolves the path
	// against this file, so every workspace's `--config ../../oxlintrc.json` run
	// loads the same plugin source.
	"jsPlugins": ["./packages/oxlint-plugin-owlat/src/index.ts"],
	// A suppression that no longer suppresses anything fails the run, so a stale
	// directive is deleted instead of silently outliving the code it excused.
	"options": {
		"reportUnusedDisableDirectives": "error"
	},
	"categories": {
		"suspicious": "warn"
	},
	"env": {
		"browser": true,
		"node": true,
		"es2024": true
	},
	"globals": {
		"defineNuxtConfig": "readonly",
		"defineNuxtPlugin": "readonly",
		"defineNuxtRouteMiddleware": "readonly",
		"definePageMeta": "readonly",
		"defineEventHandler": "readonly",
		"useRuntimeConfig": "readonly",
		"useNuxtApp": "readonly",
		"useFetch": "readonly",
		"useAsyncData": "readonly",
		"useState": "readonly",
		"useRoute": "readonly",
		"useRouter": "readonly",
		"navigateTo": "readonly",
		"createError": "readonly"
	},
	"rules": {
		"eqeqeq": [
			"error",
			"always",
			{
				"null": "ignore"
			}
		],
		"no-unused-vars": "error",
		"no-console": [
			"warn",
			{
				"allow": ["info", "warn", "error"]
			}
		],
		"@typescript-eslint/no-explicit-any": "error",
		// @ts-ignore and @ts-nocheck stay banned outright. @ts-expect-error is allowed
		// here because owlat/require-suppression-reason checks its reason, which may
		// sit after the directive or in a comment on the line above; the built-in
		// rule only accepts the inline form.
		"@typescript-eslint/ban-ts-comment": [
			"error",
			{
				"ts-expect-error": false,
				"ts-ignore": true,
				"ts-nocheck": true,
				"ts-check": false
			}
		],
		"@typescript-eslint/no-non-null-asserted-optional-chain": "error",
		"@typescript-eslint/prefer-optional-chain": "error",
		"no-unsafe-optional-chaining": "error",
		"@typescript-eslint/consistent-type-imports": "warn",
		"import/no-duplicates": "warn",
		"unicorn/no-array-for-each": "warn",
		"import/no-cycle": "error",
		"no-underscore-dangle": "off",
		"unicorn/no-array-sort": "off",
		"unicorn/no-array-reverse": "off",
		"unicorn/consistent-function-scoping": "off",
		"no-shadow": "off",
		"import/no-named-as-default-member": "off",
		"import/no-unassigned-import": "off",
		"owlat/require-suppression-reason": "error",
		"owlat/no-test-in-loop": "error",
		"owlat/no-test-environment-pragma": [
			"error",
			{
				// Paths are repository-relative and match whichever directory oxlint
				// runs from. Every other test file takes its package's vitest config.
				"allow": [
					{
						// email-builder's vitest config runs in node; its DOM-mounting
						// specs opt into happy-dom one file at a time.
						"environment": "happy-dom",
						"files": ["packages/email-builder/**"]
					},
					{
						// apps/web runs in happy-dom; these specs read the filesystem,
						// spawn processes or time pure code and need node instead.
						"environment": "node",
						"files": [
							"apps/web/app/components/postbox/__tests__/PostboxReaderMotion.test.ts",
							"apps/web/app/components/postbox/__tests__/PostboxReaderSecondaryActions.test.ts",
							"apps/web/app/components/postbox/__tests__/PostboxReadingPaneGeometry.test.ts",
							"apps/web/app/lib/__tests__/welcomeStampTiming.test.ts",
							"apps/web/app/__tests__/areaRuntime.test.ts",
							"apps/web/app/__tests__/assetDelivery.test.ts",
							"apps/web/app/__tests__/catalogAreas.test.ts",
							"apps/web/app/__tests__/completeCatalogs.test.ts",
							"apps/web/app/__tests__/contentSecurityPolicy.test.ts",
							"apps/web/app/__tests__/emailBuilderBarrelConsumers.test.ts",
							"apps/web/app/__tests__/sharedSubpathAliases.test.ts",
							"apps/web/app/__tests__/testCodeOutOfBuild.test.ts",
							"apps/web/app/utils/__tests__/labelPalette.test.ts",
							"apps/web/app/utils/__tests__/postboxTrustChip.test.ts",
							"apps/web/e2e/__tests__/e2eWorkflow.test.ts",
							"apps/web/e2e/__tests__/reportCredentials.test.ts",
							"apps/web/e2e/__tests__/reportRedaction.test.ts",
							"apps/web/e2e/__tests__/resetDeployment.test.ts",
							"apps/web/e2e/__tests__/scanReportSecrets.test.ts",
							"apps/web/e2e/__tests__/seedAdmin.test.ts",
							"apps/web/e2e/__tests__/zipArchive.test.ts",
							"apps/web/server/api/auth/__tests__/proxy.test.ts",
							"apps/web/server/api/storage/__tests__/uploadConfig.test.ts",
							"apps/web/server/api/storage/__tests__/upload.test.ts",
							"apps/web/server/utils/__tests__/updater.test.ts"
						]
					}
				]
			}
		],
		// The boundary rules below replaced text-matching gates (scripts/check-*.sh)
		// that still run beside them for one release; scripts/ast-gate-parity.ts
		// diffs the two finding sets per rule. `files` / `ignore` / `allow` paths are
		// repository-relative globs matched as a path suffix (see the plugin README),
		// and every rule skips test files. Each `allow` entry says why.
		"owlat/no-crypto-primitives": [
			"error",
			{
				"files": ["apps/**", "packages/**"],
				"ignore": ["**/*.d.ts", "**/*.d.mts", "**/*.d.cts"],
				"allow": [
					{
						"files": ["apps/api/convex/lib/crypto.ts"],
						"reason": "the Convex compare and HMAC (V8 isolate and 'use node')"
					},
					{
						"files": ["packages/shared/src/constantTimeEqual.ts"],
						"reason": "the Node compare (@owlat/shared/constantTimeEqual)"
					},
					{
						"files": ["apps/convex-fn-proxy/src/allowlist.ts"],
						"reason": "hash-then-compare copy; the proxy has no workspace dependencies"
					}
				]
			}
		],
		"owlat/no-process-env": [
			"error",
			{
				"files": ["apps/api/convex/**"],
				"allow": [
					{
						"files": ["apps/api/convex/lib/env.ts"],
						"reason": "the one reader: getRequired / getOptional / getWithDefault over the EnvKey union"
					}
				]
			}
		],
		"owlat/no-log-pii": ["error", { "files": ["apps/api/convex/**"] }],
		"owlat/convex-error-taxonomy": [
			"error",
			{
				"files": ["apps/api/convex/**"],
				"allow": [
					{
						"files": ["apps/api/convex/_utils/errors.ts"],
						"reason": "the throw* helpers that emit the canonical { category, message, data? } payload"
					},
					{
						"files": ["apps/api/convex/lib/llm/admissionPort.ts"],
						"reason": "AdmissionRefusedError subclasses ConvexError in the Operation error shape ({ category: 'forbidden', message, data }) so a refused paid call reaches the client unchanged while the LLM router reads its typed reason"
					}
				]
			}
		],
		"owlat/no-raw-convex-builder": [
			"error",
			{
				"files": ["apps/api/convex/**"],
				"allow": [
					{
						"files": ["apps/api/convex/lib/authedFunctions.ts"],
						"reason": "defines the secure-by-default builders on top of the raw ones"
					}
				]
			}
		],
		// A warning: handlers that predate session threading are frozen debt in
		// scripts/owlat-lint-baseline.txt (scripts/check-owlat-lint.sh).
		"owlat/use-threaded-session": [
			"warn",
			{
				"files": ["apps/api/convex/**"],
				"ignore": ["apps/api/convex/lib/**"],
				"kinds": ["query", "mutation"],
				"floors": ["member", "role"],
				"helpers": [
					"getMutationContext",
					"getUserIdFromSession",
					"getBetterAuthSessionWithRole",
					"getBetterAuthSession",
					"requireOrgMember",
					"requireOrgPermission",
					"requireAdminContext",
					"requireOwnerContext"
				]
			}
		],
		"owlat/feature-floor-in-builder": [
			"error",
			{
				"files": ["apps/api/convex/**"],
				// A flag and the folder its gated builders cover. Add a pair when a
				// folder gains its gated builders.
				"families": [
					{ "flag": "mail.external", "files": ["apps/api/convex/mail/**"] },
					{ "flag": "transactional", "files": ["apps/api/convex/transactional/**"] },
					{ "flag": "campaigns", "files": ["apps/api/convex/campaigns/**"] },
					{ "flag": "automations", "files": ["apps/api/convex/automations/**"] },
					{ "flag": "forms", "files": ["apps/api/convex/forms/**"] },
					{ "flag": "ai.knowledge", "files": ["apps/api/convex/knowledge/**"] },
					{ "flag": "calendar.booking", "files": ["apps/api/convex/booking/**"] },
					{ "flag": "inbox", "files": ["apps/api/convex/inbox/sla/**"] }
				],
				// Postbox handlers use postboxQuery / postboxMutation, the external
				// mailbox family the externalMail* builders.
				"bareBuilders": {
					"builders": ["authedQuery", "authedMutation"],
					"files": ["apps/api/convex/mail/**"]
				},
				// Justified sites, not debt: each must stay as it is.
				"allow": [
					{
						"reason": "Soft-auth publicQuery reads in the mail.external family keep an inline assertFeatureEnabled(ctx, 'mail.external'), marked // flag-inline:, because a gated publicQuery would slip past the raw-builder ban and its // public: rule.",
						"sites": [
							"apps/api/convex/mail/external/accounts.ts:getForCurrentUser",
							"apps/api/convex/mail/mailboxMove.ts:moveStatus",
							"apps/api/convex/mail/migration.ts:getStatus",
							"apps/api/convex/mail/sendingSwitch.ts:sendingSwitchStatus"
						]
					},
					{
						"reason": "Soft-fails to null (isFeatureEnabled) rather than throwing: the admin page renders it beside other cards and reads null as no team inbox import.",
						"sites": ["apps/api/convex/mail/migrationShared.ts:getStatusShared"]
					},
					{
						"reason": "Reachable before any mail flag is on (mail/_helpers.ts exemptions): the mailbox request / fresh-start guard a mailbox-less member sees, invitation acceptance, and the team roster's mailbox column.",
						"sites": [
							"apps/api/convex/mail/mailboxRequest.ts:freshStartStatus",
							"apps/api/convex/mail/mailboxRequest.ts:provisionFromRequest",
							"apps/api/convex/mail/mailboxRequest.ts:request",
							"apps/api/convex/mail/memberMailboxStatus.ts:byMembers",
							"apps/api/convex/mail/pendingInboxMembership.ts:claimInboxMemberships",
							"apps/api/convex/mail/pendingMailbox.ts:cancelForInvitation",
							"apps/api/convex/mail/pendingMailbox.ts:claimForInvitation",
							"apps/api/convex/mail/pendingMailbox.ts:setForInvitation"
						]
					},
					{
						"reason": "Instance capability, not mail data: a boolean from env presence that the connect form reads to pick its branch.",
						"sites": ["apps/api/convex/mail/external/googleOAuth.ts:isConfigured"]
					},
					{
						"reason": "The AI handling rules serve the ai.autonomy surface, not Postbox (mail/_helpers.ts exemption).",
						"sites": [
							"apps/api/convex/mail/handlingRules.ts:create",
							"apps/api/convex/mail/handlingRules.ts:remove",
							"apps/api/convex/mail/handlingRules.ts:update"
						]
					}
				]
			}
		]
	},
	"overrides": [
		{
			"files": ["**/__tests__/**", "**/*.test.ts", "**/*.spec.ts"],
			"rules": {
				"@typescript-eslint/no-explicit-any": "off",
				"no-unused-vars": "off"
			}
		},
		{
			"files": [
				"**/convex/conditions/index.ts",
				"**/convex/conditions/segmentMatch.ts",
				"**/convex/delivery/sendAssignmentRouting.ts",
				"**/convex/delivery/sendAssignments.ts",
				"**/convex/lib/sendProviders/cellRoute.ts",
				"**/convex/lib/sendProviders/routeMixContext.ts",
				"**/convex/mail/filterRun.ts",
				"**/convex/mail/filters.ts",
				"**/src/parse/contentType.ts",
				"**/src/parse/headers.ts",
				"**/src/scaffoldSendProvider.ts",
				"**/src/scaffoldSendProviderModules.ts",
				"**/src/scaffoldSendProviderStubs.ts",
				"**/src/manifestSnapshot.ts",
				"**/src/manifestValue.ts",
				"**/src/settingsSchema.ts"
			],
			"rules": {
				"import/no-cycle": "warn"
			}
		}
	],
	// Convex codegen output carries a blanket `/* eslint-disable */` that would
	// trip the unused-directive report; generated code is fixed in its generator.
	"ignorePatterns": ["node_modules", ".nuxt", ".output", "dist", "*.min.js", "**/_generated/**"]
}
